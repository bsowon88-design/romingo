---
// 공식 홍보영상 — 처음엔 썸네일만, 누르면 이 자리에서 재생 (새 창 안 열림)
import { VIDEOS } from '../data/videos.js';
const { city } = Astro.props;
const v = VIDEOS[city.slug];
---
{v && (
  <section class="cvid" id="video" data-vid={v.id}>
    <h2>🎬 {city.ko} 공식 홍보영상</h2>
    <button type="button" class="vbox" aria-label={`${city.ko} 홍보영상 재생`}>
      <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" />
      <span class="vplay" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.7C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4A8.5 8.5 0 0 0 1.5 7.7C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#E8794A"/><path d="M27 34V14l18 10z" fill="#fff"/></svg></span>
    </button>
    <p class="vsrc">출처: {v.by} · YouTube{v.note && ` · ${v.note}`}</p>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-vid]').forEach((sec) => {
    const id = sec.dataset.vid!;
    const box = sec.querySelector<HTMLButtonElement>('.vbox')!;
    const img = box.querySelector('img')!;
    // 지워진 영상은 유튜브가 120px 짜리 빈 그림을 줌 → 칸을 숨김
    const check = () => { if (img.naturalWidth && img.naturalWidth <= 120) sec.hidden = true; };
    img.complete ? check() : img.addEventListener('load', check);
    img.addEventListener('error', () => (sec.hidden = true));
    box.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      f.title = sec.querySelector('h2')?.textContent || '홍보영상';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.className = 'vframe';
      box.replaceWith(f);
    });
  });
</script>

<style>
  .cvid[hidden] { display: none; }
  .vbox { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; border-radius: 16px; overflow: hidden; background: #2E2420; cursor: pointer; }
  .vbox img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s; }
  .vbox:hover img { transform: scale(1.02); }
  .vplay { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(transparent 55%, rgba(0,0,0,.25)); }
  .vbox:hover .vplay svg { transform: scale(1.08); }
  .vplay svg { transition: transform .2s; filter: drop-shadow(0 2px 6px rgba(0,0,0,.3)); }
  .cvid :global(.vframe) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 16px; background: #000; }
  .vsrc { margin: 6px 0 0; font-size: 12.5px; color: var(--sub); }
</style>

---
import { STATUS_KO, ALARM_KO } from '../data/load.js';
import { tzDiff, tzDiffText, flagOf } from '../data/countries.js';
import Flag from './Flag.astro';
import PhotoCredit from './PhotoCredit.astro';
import { countryPhoto } from '../data/photos.js';
const { c } = Astro.props;
const st = c.st;
const diff = tzDiff(c.tz);
const ph = countryPhoto(c.slug);
const al = c.alarm && c.alarm.max ? c.alarm : null;
const partial = al && al.levels.every((l) => /일부/.test(l.region));
---
<a class="ccard" href={`/country/${c.slug}/`} data-name={`${c.ko} ${c.cities.join(' ')}`}
   style={`--c1:${c.color[0]};--c2:${c.color[1]}`}>
  <span class:list={['ctop', 'hasbg', { photo: ph }]}>
    {ph && <img class="bgimg" src={ph.src(480, 270)} srcset={ph.srcset(480, 270)} alt={ph.alt || c.ko} loading="lazy" decoding="async" style={`background:${ph.color}`} />}
    {ph && <PhotoCredit p={ph} link={false} />}
    <span class="cflag"><Flag iso={flagOf(c)} size={42} alt={`${c.ko} 국기`} /></span>
    <span class={`badge b-${st.level}`}>{STATUS_KO[st.level].tag}</span>
  </span>
  <span class="cbody">
    <b>{c.ko}</b>
    {al ? <span class={`mchip ${ALARM_KO[al.max].cls}`}>여행경보 {partial ? '일부 지역 ' : ''}{al.max}단계 {ALARM_KO[al.max].label}</span> : <span class="mchip m0">여행경보 없음</span>}
    <span class="ccity">{c.cities.slice(0, 3).join(' · ')}</span>
    <span class="cmeta">
      <span>🕐 <span data-tz={c.tz}>&nbsp;</span> <small>{tzDiffText(diff).replace('한국보다 ', '')}{c.tzLabel && ` (${c.tzLabel.replace(' 기준', '')})`}</small></span>
    </span>
  </span>
</a>

<style>
  .ccard { display: flex; flex-direction: column; text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; transition: transform .15s, box-shadow .15s; }
  .ccard:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(90,50,30,.08); }
  .ctop { display: flex; justify-content: space-between; align-items: flex-start; padding: 14px 14px 26px; min-height: 76px; background: linear-gradient(135deg, var(--c1), var(--c2)); }
  .cflag { line-height: 0; }
  .cflag :global(.flag) { border-radius: 5px; box-shadow: 0 2px 6px rgba(0,0,0,.18), 0 0 0 2px rgba(255,255,255,.9); }
  .ctop.photo { min-height: 118px; }
  .ctop .badge { box-shadow: 0 0 0 2px rgba(255,255,255,.9); }
  .cbody { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px 13px; }
  .cbody b { font-size: 17px; letter-spacing: -0.01em; }
  .cbody .mchip { align-self: flex-start; margin: 2px 0; }
  .ccity { font-size: 13px; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmeta { font-size: 12.5px; color: var(--sub); margin-top: 4px; }
  .cmeta small { opacity: .8; }
  @media (max-width: 760px) {
    .ctop { padding: 10px 10px 18px; min-height: 60px; }
    .ctop.photo { min-height: 84px; }
    .cflag :global(.flag) { width: 32px; height: 24px; }
    .ctop .badge { font-size: 11px; padding: 2px 7px; }
    .cbody { padding: 8px 10px 10px; }
    .cbody b { font-size: 15.5px; }
    .cbody .mchip { font-size: 11px; padding: 2px 6px; white-space: normal; }
    .ccity { font-size: 12px; }
    .cmeta { font-size: 11.5px; }
    .ctop :global(.pcredit) { font-size: 8.5px; right: 6px; bottom: 4px; }
  }
</style>

---
import { STATUS_KO, ALARM_KO } from '../data/load.js';
import { tzDiff, tzDiffText } from '../data/countries.js';
const { c } = Astro.props;
const st = c.st;
const diff = tzDiff(c.tz);
const al = c.alarm && c.alarm.max ? c.alarm : null;
const partial = al && al.levels.every((l) => /일부/.test(l.region));
---
<a class="ccard" href={`/country/${c.slug}/`} data-name={`${c.ko} ${c.cities.join(' ')}`}
   style={`--c1:${c.color[0]};--c2:${c.color[1]}`}>
  <span class="ctop">
    <span class="cflag">{c.flag}</span>
    <span class={`badge b-${st.level}`}>{STATUS_KO[st.level].label}</span>
  </span>
  <span class="cbody">
    <b>{c.ko}</b>
    {al && <span class={`mchip ${ALARM_KO[al.max].cls}`}>외교부 {al.max}단계 {ALARM_KO[al.max].label}{partial ? ' (일부)' : ''}</span>}
    <span class="ccity">{c.cities.slice(0, 3).join(' · ')}</span>
    <span class="cmeta">
      <span>🕐 <span data-tz={c.tz}>&nbsp;</span> <small>{tzDiffText(diff).replace('한국보다 ', '')}</small></span>
    </span>
  </span>
</a>

<style>
  .ccard { display: flex; flex-direction: column; text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; transition: transform .15s, box-shadow .15s; }
  .ccard:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(20,35,47,.08); }
  .ctop { display: flex; justify-content: space-between; align-items: flex-start; padding: 14px 14px 26px; background: linear-gradient(135deg, var(--c1), var(--c2)); }
  .cflag { font-size: 30px; line-height: 1; filter: drop-shadow(0 2px 3px rgba(0,0,0,.15)); }
  .ctop .badge { box-shadow: 0 0 0 2px rgba(255,255,255,.9); }
  .cbody { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px 13px; }
  .cbody b { font-size: 17px; letter-spacing: -0.01em; }
  .cbody .mchip { align-self: flex-start; margin: 2px 0; }
  .ccity { font-size: 13px; color: var(--sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmeta { font-size: 12.5px; color: var(--sub); margin-top: 4px; }
  .cmeta small { opacity: .8; }
</style>

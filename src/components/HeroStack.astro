---
// 홈 첫 화면 오른쪽 — 잡지 표지처럼 직각 사진 3장 (많이 가는 나라 순서, Unsplash 사진 + 작가 표시)
import { bySlug } from '../data/countries.js';
import { countryPhoto } from '../data/photos.js';

const ORDER = ['japan', 'vietnam', 'thailand', 'taiwan', 'philippines', 'hongkong', 'singapore', 'china'];
const items = ORDER.map((s) => bySlug[s])
  .filter(Boolean)
  .map((c) => ({ c, ph: countryPhoto(c.slug) }))
  .filter((x) => x.ph)
  .slice(0, 3);
---
{items.length > 0 && (
  <div class="cover" aria-label="인기 여행지 사진">
    {items.map(({ c, ph }, i) => (
      <a class={`pic p${i}`} href={`/country/${c.slug}/`} style={`--c:${ph.color || '#cde'}`}>
        <img src={ph.src(i === 0 ? 900 : 560, i === 0 ? 700 : 400)} alt={ph.alt || c.ko} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : 'auto'} />
        <span class="cap"><b>{c.ko}</b>{i === 0 && c.landmark ? <small>{c.landmark}</small> : null}</span>
        <span class="cr">Photo · {ph.name} / Unsplash</span>
      </a>
    ))}
  </div>
)}

<style>
  .cover { display: grid; grid-template-columns: 1.65fr 1fr; grid-template-rows: 1fr 1fr; gap: 6px; aspect-ratio: 1.42 / 1; background: transparent; padding: 0; border: 0; }
  .pic { position: relative; display: block; overflow: hidden; text-decoration: none; background: var(--c); min-height: 0; }
  .p0 { grid-row: 1 / 3; }
  .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .pic:hover img { transform: scale(1.04); }
  .cap { position: absolute; left: 0; bottom: 0; display: flex; align-items: baseline; gap: 10px; padding: 7px 14px; background: var(--emerald-d); color: #fff; }
  .cap b { font-size: 17px; letter-spacing: -0.02em; }
  .cap small { font-size: 12.5px; opacity: .85; }
  .p1 .cap, .p2 .cap { padding: 5px 10px; }
  .p1 .cap b, .p2 .cap b { font-size: 14px; }
  .cr { position: absolute; right: 8px; top: 7px; font-size: 10px; color: rgba(255,255,255,.92); text-shadow: 0 1px 2px rgba(0,0,0,.65); }
  .p1 .cr, .p2 .cr { display: none; }
  @media (max-width: 760px) { .cover { aspect-ratio: 1.3 / 1; } .cap b { font-size: 15px; } .cap small { display: none; } }
</style>

---
// 메뉴 페이지 맨 위 머리글 — 사진 없이 글자와 선으로만 (여행잡지 스타일). name 은 예전 호환용으로 받기만 함.
const { name = '' } = Astro.props;
---
<section class="pbn" data-name={name}>
  <div class="pbn-in"><slot /></div>
</section>

<style>
  .pbn { position: relative; text-align: center; margin: 0 0 44px; padding: 64px 0 28px; border: 0; }
  .pbn-in { max-width: 820px; margin: 0 auto; }
  .pbn-in :global(.crumb) { margin: 0 0 14px; font-size: 12px; font-weight: 800; letter-spacing: .16em; color: #243c4e; }
  .pbn-in :global(.crumb a) { color: #243c4e; text-decoration: none; }
  .pbn-in :global(h1) { margin: 0 0 14px; font-size: 56px; line-height: 1.12; letter-spacing: -0.03em; font-weight: 800; color: #0f2233; }
  .pbn-in :global(.lead) { margin: 0 auto; max-width: 40em; color: #243c4e; font-size: 17px; line-height: 1.65; font-weight: 500; }
  @media (max-width: 760px) {
    .pbn { margin-bottom: 28px; padding: 36px 0 18px; }
    .pbn-in :global(h1) { font-size: 33px; }
    .pbn-in :global(.lead) { font-size: 14.5px; }
  }
</style>

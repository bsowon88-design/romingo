---
// 메뉴 페이지 맨 위 사진 배너 — 사진은 public/banners/{name}.webp (PC 4:1) · {name}-m.webp (폰)
// 제목·설명은 사진 위에 글자로 올림 (사진 안에는 글자 없음)
const { name, pos = 'right center' } = Astro.props;
---
<section class="pbn">
  <picture>
    <source media="(max-width: 760px)" srcset={`/banners/${name}-m.webp`} />
    <img src={`/banners/${name}.webp`} alt="" width="1600" height="400" fetchpriority="high" style={`object-position:${pos}`} />
  </picture>
  <div class="pbn-in"><slot /></div>
</section>

<style>
  .pbn { position: relative; isolation: isolate; overflow: hidden; border-radius: 22px; margin: 6px 0 22px; min-height: 230px; display: flex; align-items: center; background: #F8D9BF; }
  .pbn picture, .pbn img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pbn img { object-fit: cover; z-index: -2; }
  .pbn::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(255,246,239,.6) 0%, rgba(255,246,239,.35) 40%, rgba(255,246,239,0) 60%); }
  .pbn-in { padding: 30px 36px; max-width: 500px; }
  .pbn-in :global(.crumb) { margin: 0 0 6px; }
  .pbn-in :global(h1) { margin: 0 0 8px; font-size: 34px; }
  .pbn-in :global(.lead) { margin: 0; color: #4A372D; font-size: 16px; line-height: 1.6; }
  @media (max-width: 760px) {
    .pbn { min-height: 0; border-radius: 18px; margin: 4px 0 18px; align-items: flex-end; }
    .pbn::before { background: linear-gradient(180deg, rgba(255,246,239,0) 0%, rgba(255,246,239,.15) 35%, rgba(255,246,239,.88) 70%); }
    .pbn-in { padding: 110px 16px 16px; }
    .pbn-in :global(h1) { font-size: 25px; }
    .pbn-in :global(.lead) { font-size: 14.5px; }
  }
</style>

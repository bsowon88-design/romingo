---
// 메뉴 페이지 맨 위 머리글 — 사진 없이 글자와 선으로만 (여행잡지 스타일). name 은 예전 호환용으로 받기만 함.
const { name = '' } = Astro.props;
---
<section class="pbn" data-name={name}>
  <div class="pbn-in"><slot /></div>
</section>

<style>
  .pbn { position: relative; margin: 0 0 26px; padding: 0 0 22px; border-bottom: 2px solid #0f2233; }
  .pbn::before { content: ''; display: block; width: 44px; height: 6px; background: #ef6a2a; margin: 0 0 16px; }
  .pbn-in { max-width: 760px; }
  .pbn-in :global(.crumb) { margin: 0 0 8px; font-size: 12.5px; font-weight: 700; letter-spacing: .04em; color: #566877; }
  .pbn-in :global(h1) { margin: 0 0 10px; font-size: 46px; line-height: 1.12; letter-spacing: -0.055em; font-weight: 900; color: #0f2233; }
  .pbn-in :global(.lead) { margin: 0; color: #243c4e; font-size: 17px; line-height: 1.6; font-weight: 500; }
  @media (max-width: 760px) {
    .pbn { margin-bottom: 20px; padding-bottom: 16px; }
    .pbn::before { margin-bottom: 12px; }
    .pbn-in :global(h1) { font-size: 31px; }
    .pbn-in :global(.lead) { font-size: 14.5px; }
  }
</style>

---
import { SITE_NAME, SITE_TAGLINE, SITE_URL, SITE_DESC, MOFA_URL } from '../site.js';
import Icon from '../components/Icon.astro';
import { SEARCH_INDEX, ALARM_INDEX } from '../data/search.js';
import { ALARM_KO } from '../data/load.js';
const { title, desc = SITE_DESC, noindex = false } = Astro.props;
const full = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} - ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const path = Astro.url.pathname;
// [주소, 이름, 아이콘, 폰 아래 메뉴에 넣을지]
const nav = [
  ['/popular/', '인기 도시', 'plane', true],
  ['/country/', '나라별', 'globe', true],
  ['/weather/', '날씨', 'cloud-sun', false],
  ['/safety/', '안전 정보', 'shield-check', true],
  ['/rates/', '환율', 'coins', true],
];
const isOn = (href) => (href === '/' ? path === '/' : path.startsWith(href) || (href === '/safety/' && (path.startsWith('/quakes') || path.startsWith('/disasters') || path.startsWith('/quake/'))));
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="로밍고 - 해외 여행지 안전 · 날씨 · 가이드" />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og.png', SITE_URL).href} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <slot name="head" />
</head>
<body>
  <header class="top">
    <div class="wrap top-in">
      <a href="/" class="logo"><img class="logo-img" src="/favicon-48.png" srcset="/favicon-48.png 1x, /apple-touch-icon.png 2x" width="30" height="30" alt="로밍고 홈" /><span class="logo-txt">로밍고</span><small>{SITE_TAGLINE}</small></a>
      <nav id="mainnav">
        {nav.map(([href, label, icon]) => (
          <a href={href} class={isOn(href) ? 'on' : ''}><Icon name={icon} size={18} />{label}</a>
        ))}
      </nav>
      <div class="tact">
        {path !== '/' && <button class="ibtn" id="sopen" aria-label="검색"><Icon name="search" size={20} /></button>}
        <a class:list={['sbtn', 'mytrip', { on: path.startsWith('/my/') }]} href="/my/" aria-label="나의 여행"><Icon name="luggage" size={18} /><span>나의 여행</span></a>
        <button class="sbtn" id="share" aria-label="공유하기"><Icon name="share" size={18} /><span>공유하기</span></button>
      </div>
    </div>
  </header>


  <div class="sbox-wrap" id="sbox" hidden>
    <div class="sbox-in">
      <div class="sbar">
        <Icon name="search" size={20} />
        <input id="sq" type="search" placeholder="나라나 도시 (예: 다낭, 오사카, japan)" autocomplete="off" />
        <button id="sclose" aria-label="닫기"><Icon name="x" size={22} /></button>
      </div>
      <div id="sres" class="sres"><p class="shint">나라나 도시 이름을 쳐 보세요.</p></div>
    </div>
  </div>
  <script type="application/json" id="sidx" set:html={JSON.stringify(SEARCH_INDEX)}></script>
  <script type="application/json" id="aidx" set:html={JSON.stringify({ a: ALARM_INDEX, l: Object.fromEntries(Object.entries(ALARM_KO).map(([k, v]) => [k, [v.label, v.cls]])), u: MOFA_URL })}></script>

  <main class="wrap">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap">
      <p><b>자료 출처</b> 미국 지질조사국(USGS) · 국제 재난경보(GDACS) · 외교부 · 한국은행 · 인천국제공항공사 · 노르웨이 기상청(MET Norway, CC BY 4.0) · NASA POWER — 공식 데이터를 자동으로 정리해요. 나라 기본 정보는 여행 전에 한 번 더 확인하세요.</p>
      <p>로밍고는 참고용 정보예요. 여행 전에는 꼭 <a href={MOFA_URL} target="_blank" rel="noopener">외교부 해외안전여행</a>과 현지 정부·항공사 공지를 확인하세요.</p>
      <p class="foot-links"><a href="/about/">로밍고 소개</a> · <a href="/privacy/">개인정보처리방침</a> · <a href="/credits/">사진 출처</a></p>
      <p class="copy">© {new Date().getFullYear()} {SITE_NAME}</p>
    </div>
  </footer>
  <script>
    // 어디서나 검색
    const box = document.getElementById('sbox');
    const q = document.getElementById('sq') as HTMLInputElement | null;
    const res = document.getElementById('sres');
    let IDX: any[] | null = null;
    const idx = () => (IDX ||= JSON.parse(document.getElementById('sidx')?.textContent || '[]'));
    const open = () => { if (!box) return; box.hidden = false; document.body.classList.add('noscroll'); setTimeout(() => q?.focus(), 30); };
    const close = () => { if (!box) return; box.hidden = true; document.body.classList.remove('noscroll'); };
    document.getElementById('sopen')?.addEventListener('click', open);

    // 공유하기 — 폰은 공유 창(카톡 등), PC는 주소 복사
    const toast = (msg: string) => {
      const t = document.createElement('div');
      t.className = 'toast'; t.textContent = msg;
      document.body.append(t); setTimeout(() => t.remove(), 2200);
    };
    document.getElementById('share')?.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share && matchMedia('(pointer: coarse)').matches) { await navigator.share(data); return; }
      } catch (e) { if ((e as Error)?.name === 'AbortError') return; }
      try { await navigator.clipboard.writeText(location.href); toast('주소를 복사했어요. 카톡에 붙여 넣어 보내세요'); }
      catch { prompt('이 주소를 복사하세요', location.href); }
    });
    document.querySelectorAll('[data-open-search]').forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); open(); }));
    document.getElementById('sclose')?.addEventListener('click', close);
    box?.addEventListener('click', (e) => { if (e.target === box) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      if (e.key === '/' && box?.hidden && !(e.target instanceof HTMLInputElement)) { e.preventDefault(); open(); }
    });

    const el = (tag: string, cls = '', text = '', href = '') => {
      const n = document.createElement(href ? 'a' : tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      if (href) n.setAttribute('href', href);
      return n;
    };

    function render(text: string, res: HTMLElement | null) {
      if (!res) return;
      const t = text.trim().toLowerCase().replace(/\s+/g, '');
      res.replaceChildren();
      if (!t) { res.append(el('p', 'shint', '나라나 도시 이름을 쳐 보세요.')); return; }
      const hits = [];
      for (const c of idx()) {
        const cHit = c.k.replace(/\s/g, '').includes(t) || c.e.replace(/\s/g, '').includes(t);
        const cityHits = c.c.filter((x) => x.k.replace(/\s/g, '').includes(t) || x.s.includes(t) || x.e.replace(/\s/g, '').includes(t));
        if (cHit || cityHits.length) hits.push({ c, cityHits, cHit });
      }
      if (!hits.length) {
        // 로밍고에 없는 나라 → 외교부 여행경보라도 보여 주고 외교부로 연결
        let A: any = { a: [], l: {}, u: '' };
        try { A = JSON.parse(document.getElementById('aidx')?.textContent || '{}'); } catch {}
        const ah = (A.a || []).filter((x: any) => x[0].replace(/\s/g, '').includes(t) || (t.length >= 3 && x[1].replace(/\s/g, '').includes(t))).slice(0, 4);
        const box = el('div', 'snone');
        box.append(el('p', 'shint', ah.length ? '아직 로밍고에 정리되지 않은 나라예요. 외교부 여행경보는 이래요.' : '찾는 곳이 아직 로밍고에 없어요.'));
        for (const x of ah) {
          const row = el('a', 'salarm', '', A.u);
          row.setAttribute('target', '_blank'); row.setAttribute('rel', 'noopener');
          const img = document.createElement('img');
          img.src = `/flags/${x[2]}.svg`; img.width = 24; img.height = 18; img.alt = ''; img.className = 'flag';
          img.onerror = () => img.remove();
          row.append(img, el('b', '', x[0]));
          if (x[3]) { const [lbl, cls] = A.l[x[3]]; row.append(el('span', `mchip ${cls}`, `${x[4] ? '일부 지역 ' : ''}${x[3]}단계 ${lbl}`)); }
          else row.append(el('span', 'mchip m0', '여행경보 없음'));
          box.append(row);
        }
        const go = el('a', 'btn smofa', '외교부 해외안전여행에서 보기 ↗', A.u);
        go.setAttribute('target', '_blank'); go.setAttribute('rel', 'noopener');
        box.append(go);
        res.append(box);
        return;
      }
      for (const { c, cityHits, cHit } of hits.slice(0, 6)) {
        const g = el('div', 'sgrp');
        const head = el('a', 'shead', '', `/country/${c.s}/`);
        const img = document.createElement('img');
        img.src = `/flags/${c.f}.svg`; img.width = 26; img.height = 20; img.alt = ''; img.className = 'flag';
        head.append(img, el('b', '', c.k), el('span', 'sgo', '모아보기 →'));
        g.append(head);
        const list = el('div', 'slinks');
        // 나라 이름이 맞으면 그 나라 도시 전부, 도시만 맞으면 그 도시 먼저
        const cities = cHit ? [...cityHits, ...c.c.filter((x) => !cityHits.includes(x))] : cityHits;
        for (const x of cities.filter((x) => x.g)) list.append(el('a', 'sl', `📖 ${x.k} 여행가이드`, `/guide/${x.s}/`));
        const wc = cities.filter((x) => x.w).slice(0, 6);
        if (wc.length) {
          const row = el('span', 'sl wrow');
          row.append(el('span', '', '🌤️ 날씨 '));
          wc.forEach((x, i) => { if (i) row.append(document.createTextNode(' · ')); row.append(el('a', '', x.k, `/weather/${x.s}/`)); });
          list.append(row);
        }
        list.append(el('a', 'sl', `🛡️ 안전 정보${c.a ? ` (${c.a})` : ''}`, `/country/${c.s}/safety/`));
        list.append(el('a', 'sl', `💱 환율·긴급번호${c.r ? ` (${c.r})` : ''}`, `/country/${c.s}/info/`));
        g.append(list);
        res.append(g);
      }
    }
    q?.addEventListener('input', () => render(q.value, res));
    q?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { const a = res?.querySelector('a') as HTMLAnchorElement | null; if (a) location.href = a.href; }
    });

    // 페이지 안에 있는 검색창 (홈 등) — 창을 띄우지 않고 바로 아래에 결과를 펼침
    document.querySelectorAll<HTMLInputElement>('[data-search-inline]').forEach((inp) => {
      const wrap = inp.closest('.isearch');
      const out = wrap?.querySelector<HTMLElement>('.ires') || null;
      const show = () => { const v = inp.value.trim(); if (out) { out.hidden = !v; if (v) render(inp.value, out); } };
      inp.addEventListener('input', show);
      inp.addEventListener('focus', show);
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { const a = out?.querySelector('a') as HTMLAnchorElement | null; if (a) location.href = a.href; }
        if (e.key === 'Escape' && out) out.hidden = true;
      });
      document.addEventListener('click', (e) => { if (out && wrap && !wrap.contains(e.target as Node)) out.hidden = true; });
    });
  </script>
  <script>
    // 폰에서 지금 메뉴가 화면 밖이면 보이게 옆으로 밀어 둠
    const on = document.querySelector<HTMLElement>('#mainnav a.on');
    const nav = document.getElementById('mainnav');
    if (nav && nav.scrollWidth > nav.clientWidth + 1) nav.classList.add('ovf');
    if (on && nav && nav.scrollWidth > nav.clientWidth) {
      const left = on.getBoundingClientRect().left - nav.getBoundingClientRect().left;
      const right = left + on.offsetWidth;
      if (right > nav.clientWidth - 24) nav.scrollLeft = Math.max(0, left - 12);
    }
  </script>
  <script>
    // 화면의 현지 시각(data-tz)을 30초마다 바꿈
    const tick = () => {
      document.querySelectorAll('[data-tz]').forEach((el) => {
        try {
          el.textContent = new Intl.DateTimeFormat('ko-KR', {
            timeZone: el.dataset.tz, hour: '2-digit', minute: '2-digit', hour12: false,
            ...(el.dataset.full ? { month: 'long', day: 'numeric', weekday: 'short' } : {}),
          }).format(new Date());
        } catch {}
      });
    };
    tick();
    setInterval(tick, 30000);
  </script>
</body>
</html>

<style is:global>
  :root {
    --ink: #2E2420;
    --sub: #7A665B;
    --line: #F0E2D8;
    --bg: #FFF6EF;
    --card: #fff;
    --navy: #12324a;
    --sea: #C85E30;
    --coral: #E8794A;
    --apricot: #FFE3D1;
    --red: #d6383a;
    --orange: #e8822a;
    --yellow: #d9a514;
    --green: #2f9e6a;
    --gray: #8a97a2;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: 'Pretendard Variable', Pretendard, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.6;
    word-break: keep-all;
  }
  a { color: inherit; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 18px; }
  main.wrap { padding-top: 22px; padding-bottom: 48px; min-height: 60vh; }

  .top { background: rgba(255,253,251,.95); backdrop-filter: blur(8px); color: var(--ink); position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--line); }
  .top-in { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; height: 64px; }
  .logo { text-decoration: none; font-weight: 800; font-size: 20px; display: flex; align-items: baseline; gap: 6px; letter-spacing: -0.02em; }
  .logo { align-items: center !important; }
  .logo-img { width: 30px; height: 30px; flex: none; align-self: center; }
  .logo small { font-weight: 500; font-size: 12px; color: var(--sub); }
  .top nav { display: flex; justify-content: center; gap: 4px; }
  .top nav a { position: relative; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-size: 16px; font-weight: 700; color: #4A3A32; padding: 10px 12px; border-radius: 10px; white-space: nowrap; }
  .top nav a .ico { color: #C9A897; }
  .top nav a:hover { background: #FFF0E6; color: var(--sea); }
  .top nav a:hover .ico, .top nav a.on .ico { color: var(--sea); }
  .top nav a.on { color: var(--sea); }
  .top nav a.on::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -3px; height: 3px; border-radius: 3px; background: var(--sea); }
  .sbtn { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-weight: 700; font-size: 15px; color: #4A3A32; background: #FFF0E6; border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
  .sbtn:hover { border-color: var(--sea); color: var(--sea); }
  .snone { display: flex; flex-direction: column; gap: 8px; padding: 4px 2px; }
  .snone .shint { margin: 0; }
  .salarm { display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
  .salarm:hover { border-color: var(--coral); }
  .salarm .flag { border-radius: 3px; box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
  .m0 { background: #e8f5ee; color: #1d7a4c; }
  .smofa { align-self: flex-start; }
  a.sbtn { text-decoration: none; }
  .mytrip { background: #fff; }
  .mytrip.on { border-color: var(--sea); color: var(--sea); }
  .tact { display: flex; align-items: center; gap: 6px; }
  .ibtn { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: #4A3A32; cursor: pointer; }
  .ibtn:hover { border-color: var(--sea); color: var(--sea); }
  .toast { position: fixed; left: 50%; bottom: 90px; transform: translateX(-50%); z-index: 60; background: rgba(46,36,32,.92); color: #fff; font-size: 14px; font-weight: 600; padding: 10px 16px; border-radius: 999px; pointer-events: none; }

  .sbox-wrap { position: fixed; inset: 0; z-index: 50; background: rgba(60,35,20,.45); display: flex; justify-content: center; align-items: flex-start; padding: 70px 14px 14px; }
  .sbox-wrap[hidden] { display: none; }
  .sbox-in { width: 100%; max-width: 640px; background: #fff; border-radius: 18px; box-shadow: 0 20px 60px rgba(0,0,0,.25); overflow: hidden; display: flex; flex-direction: column; max-height: calc(100vh - 90px); }
  .sbar { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); color: var(--sub); }
  .sbar input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 18px; color: var(--ink); background: transparent; padding: 6px 0; }
  .sbar .ico, .sbtn .ico, .search .ico { flex: none; }
  input[type='search']::-webkit-search-cancel-button { -webkit-appearance: none; display: none; }
  .sbar button { background: none; border: 0; color: var(--sub); cursor: pointer; padding: 4px; }
  .sres { overflow-y: auto; padding: 8px 10px 14px; }
  .shint { color: var(--sub); padding: 14px 6px; margin: 0; }
  .sgrp { border: 1px solid var(--line); border-radius: 14px; margin: 8px 0; overflow: hidden; }
  .shead { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #FFF4EC; text-decoration: none; font-size: 17px; }
  .shead:hover { background: #FFEBDF; }
  .sgo { margin-left: auto; font-size: 13px; font-weight: 700; color: var(--sea); }
  .slinks { display: flex; flex-direction: column; padding: 6px 8px 10px; }
  .sl { display: block; text-decoration: none; padding: 7px 8px; border-radius: 8px; font-size: 15px; }
  a.sl:hover { background: #FFF0E6; }
  .wrow a { color: var(--sea); text-decoration: none; font-weight: 600; }
  body.noscroll { overflow: hidden; }
  .isearch { position: relative; }
  .ires { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 30; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 16px 40px rgba(90,50,30,.18); max-height: 70vh; }
  .ires[hidden] { display: none; }
  .hasbg { position: relative; overflow: hidden; isolation: isolate; }
  .hasbg > .bgimg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hasbg.photo::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.55) 100%); }
  .flag { display: inline-block; vertical-align: -2px; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,.08); object-fit: cover; }
  @media (max-width: 900px) {
    .logo small { display: none; }
    .top nav a { font-size: 15px; padding: 10px 8px; }
  }
  @media (max-width: 760px) {
    .top-in { grid-template-columns: 1fr auto; grid-template-areas: 'logo act' 'nav nav'; gap: 0; height: auto; padding-top: 6px; }
    .logo { grid-area: logo; }
    .tact { grid-area: act; }
    .top nav { grid-area: nav; height: 40px; margin: 2px -8px 0; }
    .logo-txt, .logo small { display: none; }
    .logo-img { width: 32px; height: 32px; }
    .top nav { justify-content: space-around; gap: 2px; overflow-x: auto; scrollbar-width: none; padding: 0; }
    .top nav.ovf { -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); padding-right: 18px; }
    .top nav::-webkit-scrollbar { display: none; }

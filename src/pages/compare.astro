---
// 도시 2곳 비교 — 날씨·비행시간·시차·안전·환율·오늘 운항을 한 표로
import Base from '../layouts/Base.astro';
import Updated from '../components/Updated.astro';
import { TRIP_DATA, CITY_GROUPS } from '../data/tripdata.js';
import { STATUS_KO, ALARM_KO } from '../data/load.js';
const labels = {
  st: Object.fromEntries(Object.entries(STATUS_KO).map(([k, v]) => [k, v.label])),
  al: Object.fromEntries(Object.entries(ALARM_KO).map(([k, v]) => [k, [v.label, v.cls]])),
};
const PAIRS = [
  ['danang', 'nhatrang'], ['tokyo', 'osaka'], ['osaka', 'fukuoka'], ['cebu', 'boracay'],
  ['bangkok', 'phuket'], ['taipei', 'hongkong'], ['danang', 'phuquoc'], ['qingdao', 'weihai'],
].filter(([a, b]) => TRIP_DATA[a] && TRIP_DATA[b]);
const opts = CITY_GROUPS;
---
<Base title="여행지 비교 - 두 도시 날씨·비행시간·시차·안전·환율" desc="다낭 vs 나트랑, 도쿄 vs 오사카처럼 고민되는 두 여행지를 날씨, 비행시간, 시차, 안전, 환율로 한 번에 비교하세요.">
  <p class="crumb"><a href="/">홈</a> › 여행지 비교</p>
  <h1>↔️ 여행지 비교</h1>
  <p class="lead">고민되는 두 도시를 골라 보세요. 날씨·비행시간·시차·안전·환율을 나란히 보여 줘요.</p>

  <div class="pick card">
    {['a', 'b'].map((k, i) => (
      <>
        {i === 1 && <span class="vs">VS</span>}
        <select id={`c-${k}`} aria-label={`도시 ${i + 1}`}>
          <option value="">도시 고르기</option>
          {opts.map((g) => <optgroup label={g.ko}>{g.cities.map((c) => <option value={c.slug}>{c.ko}</option>)}</optgroup>)}
        </select>
      </>
    ))}
    <select id="c-m" aria-label="여행 달">
      {Array.from({ length: 12 }, (_, i) => <option value={i + 1}>{i + 1}월 여행</option>)}
    </select>
  </div>

  <div class="pairs">
    <span>많이 비교해요</span>
    {PAIRS.map(([a, b]) => <a href={`/compare/?a=${a}&b=${b}`} data-a={a} data-b={b}>{TRIP_DATA[a].ko} vs {TRIP_DATA[b].ko}</a>)}
  </div>

  <div id="cmp" class="cmp"></div>
  <Updated />
  <p class="muted small">비행시간은 서울에서 직선거리로 어림한 값이에요(직항 기준, 실제와 조금 다를 수 있어요). 날씨는 최근 10년 평균(NASA POWER), 오늘 운항은 인천국제공항공사·한국공항공사 자료예요(인천·김포·김해·제주 출발).</p>

  <script type="application/json" id="tdata" set:html={JSON.stringify(TRIP_DATA)}></script>
  <script type="application/json" id="tlabels" set:html={JSON.stringify(labels)}></script>
</Base>

<script>
  import { loadLive, el } from '../scripts/live';
  const DATA = JSON.parse(document.getElementById('tdata')!.textContent || '{}');
  const LB = JSON.parse(document.getElementById('tlabels')!.textContent || '{}');
  const $a = document.getElementById('c-a') as HTMLSelectElement;
  const $b = document.getElementById('c-b') as HTMLSelectElement;
  const $m = document.getElementById('c-m') as HTMLSelectElement;
  const q = new URLSearchParams(location.search);
  const nowM = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
  $a.value = DATA[q.get('a') || ''] ? q.get('a')! : 'danang';
  $b.value = DATA[q.get('b') || ''] && q.get('b') !== $a.value ? q.get('b')! : $a.value === 'nhatrang' ? 'danang' : 'nhatrang';
  $m.value = String(+(q.get('m') || 0) || nowM);
  let FL: any;

  const offH = (tz: string) => {
    const d = new Date();
    const loc = new Date(d.toLocaleString('en-US', { timeZone: tz }));
    const seoul = new Date(d.toLocaleString('en-US', { timeZone: 'Asia/Seoul' }));
    return Math.round(((loc.getTime() - seoul.getTime()) / 36e5) * 2) / 2;
  };
  const diffText = (h: number) => (h === 0 ? '시차 없음' : `한국보다 ${Math.abs(h)}시간 ${h < 0 ? '느림' : '빠름'}`);
  const ftext = (raw: number) => {
    const min = Math.round(raw / 10) * 10;
    const h = Math.floor(min / 60), mm = min % 60;
    return `약 ${h ? h + '시간' : ''}${h && mm ? ' ' : ''}${mm ? mm + '분' : ''}`;
  };
  const best = (m: any[]) => {
    const sc = (d: any) => ({ good: 3, ok: 2, bad: 1 } as any)[d[3]] * 1000 - Math.abs((d[0] + d[1]) / 2 - 23) * 10 - d[2] / 10;
    return m.map((d, i) => ({ i: i + 1, s: sc(d) })).sort((x, y) => y.s - x.s).slice(0, 3).map((x) => x.i).sort((x, y) => x - y);
  };

  function row(label: string, cells: (Node | string)[], win = -1) {
    const tr = el('tr');
    tr.append(el('th', '', label));
    cells.forEach((c, i) => {
      const td = el('td', i === win ? 'win' : '');
      td.append(c);
      tr.append(td);
    });
    return tr;
  }
  const frag = (...xs: (Node | string)[]) => { const f = document.createDocumentFragment(); f.append(...xs); return f; };

  function render() {
    const A = DATA[$a.value], B = DATA[$b.value];
    const box = document.getElementById('cmp')!;
    box.innerHTML = '';
    if (!A || !B) return;
    const m = +$m.value;
    const url = `/compare/?a=${$a.value}&b=${$b.value}${m !== nowM ? `&m=${m}` : ''}`;
    history.replaceState(null, '', url);
    document.querySelectorAll<HTMLAnchorElement>('.pairs a').forEach((x) =>
      x.classList.toggle('on', (x.dataset.a === $a.value && x.dataset.b === $b.value) || (x.dataset.a === $b.value && x.dataset.b === $a.value)),
    );
    const cs = [A, B];
    const slugs = [$a.value, $b.value];
    const t = el('table', 'ctable');
    const head = el('tr');
    head.append(el('th'));
    cs.forEach((c) => {
      const th = el('th', 'ch');
      const img = el('img');
      img.src = `/flags/${c.f}.svg`; img.width = 24; img.height = 18; img.alt = '';
      th.append(img, el('b', '', c.ko), el('small', '', c.co));
      head.append(th);
    });
    t.append(head);

    // 날씨
    const W = cs.map((c) => c.m?.[m - 1]);
    const wScore = W.map((d) => (d ? ({ good: 3, ok: 2, bad: 1 } as any)[d[3]] : 0));
    const wWin = wScore[0] === wScore[1] ? -1 : wScore[0] > wScore[1] ? 0 : 1;
    t.append(row(`${m}월 날씨`, W.map((d) => (d ? frag(el('b', '', `${d[0]}° / ${d[1]}°`), el('small', `sc-${d[3]}`, `${d[5]} · ${d[4]}`)) : '자료 없음')), wWin));
    t.append(row('여행하기 좋은 달', cs.map((c) => (c.m ? best(c.m).map((x) => `${x}월`).join(' · ') : '-'))));
    const fWin = A.fm === B.fm ? -1 : A.fm < B.fm ? 0 : 1;
    t.append(row('비행시간', cs.map((c) => ftext(c.fm)), Math.abs(A.fm - B.fm) >= 20 ? fWin : -1));
    const lvN = (c: any) => ({ calm: 0, watch: 1, alert: 2 } as any)[c.lv];
    t.append(row('자연재난', cs.map((c) => frag(el('span', `badge b-${c.lv}`, LB.st[c.lv]), el('small', '', `근처 지진 ${c.q}건 · 재난 경보 ${c.d}건`))), lvN(A) === lvN(B) ? -1 : lvN(A) < lvN(B) ? 0 : 1));
    // 같은 나라 두 도시면 시차·경보·환율·전압이 같으니 아래로 내림
    const same = A.co === B.co;
    const common = () => {
      t.append(row('시차', cs.map((c) => diffText(offH(c.tz)))));
      t.append(row('외교부 여행경보', cs.map((c) => {
        if (!c.al) return '경보 없음';
        const [lbl, cls] = LB.al[c.al[0]];
        return el('span', `mchip ${cls}`, `${c.al[1] ? '일부 지역 ' : ''}${c.al[0]}단계 ${lbl}`);
      })));
      t.append(row('환율', cs.map((c) => (c.rate ? frag(el('b', '', c.rate[0]), el('small', '', c.rate[1])) : '-'))));
      t.append(row('전압·플러그', cs.map((c) => `${c.volt} · ${c.plug}`)));
    };
    if (!same) common();
    t.append(row('오늘 한국 출발편', slugs.map((s) => {
      if (FL === undefined) return '확인 중…';
      if (FL === null) return '확인 중';
      const v = FL.c?.[`c:${s}`];
      return v ? frag(el('b', '', `${v[0]}편`), el('small', v[1] ? 'bad' : v[2] ? 'warn' : '', `결항 ${v[1]} · 지연 ${v[2]}`)) : '직항 없음';
    })));
    if (same) {
      const sep = el('tr', 'same');
      const td = el('td', '', `같은 나라(${A.co})라 아래 정보는 두 도시가 같아요`);
      (td as HTMLTableCellElement).colSpan = 3;
      sep.append(td);
      t.append(sep);
      common();
    }
    t.append(row('더 보기', slugs.map((s, i) => {
      const f = el('div', 'lk');
      const add = (h: string, x: string) => { const a = el('a', '', x); a.href = h; f.append(a); };
      if (cs[i].g) add(`/guide/${s}/`, '📖 가이드');
      add(`/weather/${s}/${m}/`, `🌤️ ${m}월 날씨`);
      add(`/my/?add=${s}`, '🧳 나의 여행');
      return f;
    })));
    box.append(t);
  }
  [$a, $b, $m].forEach((x) => x.addEventListener('change', render));
  document.querySelectorAll<HTMLAnchorElement>('.pairs a').forEach((x) =>
    x.addEventListener('click', (e) => { e.preventDefault(); $a.value = x.dataset.a!; $b.value = x.dataset.b!; render(); }),
  );
  render();
  loadLive('flights').then((j) => { FL = j; }).catch(() => { FL = null; }).finally(render);
</script>

<style>
  .pick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
  .pick select { font: inherit; font-size: 16px; font-weight: 700; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: var(--ink); flex: 1; min-width: 120px; }
  .pick #c-m { flex: 0 0 auto; font-weight: 600; font-size: 15px; }
  .vs { font-weight: 900; color: var(--coral); }
  .pairs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 12px; }
  .pairs span { font-size: 13px; font-weight: 700; color: var(--sub); margin-right: 4px; }
  .pairs a { text-decoration: none; font-size: 13.5px; font-weight: 600; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }
  .pairs a.on { border-color: var(--coral); color: var(--sea); background: #FFF0E6; }
  .cmp { margin-top: 16px; }
  .cmp :global(.ctable) { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; table-layout: fixed; }
  .cmp :global(th), .cmp :global(td) { padding: 12px 14px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; font-size: 14.5px; }
  .cmp :global(tr:last-child th), .cmp :global(tr:last-child td) { border-bottom: 0; }
  .cmp :global(tr > th:first-child) { width: 130px; color: var(--sub); font-size: 13px; background: #FFFAF6; }
  .cmp :global(.ch) { background: #FFF3EA; }
  .cmp :global(tr.same td) { background: #FFFAF6; color: var(--sub); font-size: 12.5px; font-weight: 600; padding: 8px 14px; }
  .cmp :global(.ch img) { vertical-align: -3px; margin-right: 6px; border-radius: 3px; }
  .cmp :global(.ch b) { font-size: 18px; }
  .cmp :global(.ch small) { display: block; color: var(--sub); font-weight: 600; font-size: 12.5px; margin-top: 2px; }
  .cmp :global(td b) { display: block; }
  .cmp :global(td small) { display: block; color: var(--sub); font-size: 12.5px; margin-top: 3px; }
  .cmp :global(td.win) { background: #F1FAF4; }
  .cmp :global(td.win)::after { content: '👍'; font-size: 13px; }
  .cmp :global(.sc-good) { color: #1d7a4c !important; font-weight: 700; }
  .cmp :global(.sc-bad) { color: #b3452a !important; font-weight: 700; }
  .cmp :global(.bad) { color: #c0392b !important; font-weight: 700; }
  .cmp :global(.warn) { color: #b5651d !important; font-weight: 700; }
  .cmp :global(.lk) { display: flex; flex-wrap: wrap; gap: 6px; }
  .cmp :global(.lk a) { text-decoration: none; font-size: 13px; font-weight: 600; border: 1px solid var(--line); border-radius: 999px; padding: 5px 10px; }
  .small { font-size: 12.5px; }
  @media (max-width: 620px) {
    .pick select { min-width: 0; }
    .pick #c-m { flex: 1 1 100%; }
    .cmp :global(th), .cmp :global(td) { padding: 10px 8px; font-size: 13.5px; }
    .cmp :global(tr > th:first-child) { width: 74px; font-size: 12px; }
    .cmp :global(.ch b) { font-size: 16px; }
  }
</style>

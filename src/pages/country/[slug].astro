---
import Base from '../../layouts/Base.astro';
import QuakeRow from '../../components/QuakeRow.astro';
import DisasterCard from '../../components/DisasterCard.astro';
import { COUNTRIES, tzDiff, tzDiffText, CONSULAR_CALL } from '../../data/countries.js';
import { countryStatus, STATUS_KO, BUILT_AT, countryAlarm, countryAdjusts, ALARM_KO, HAS_ALARMS, countryRate } from '../../data/load.js';
import { translatePlace, kstDateTime, kstDate } from '../../data/place.js';
import { MOFA_URL } from '../../site.js';

export function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const st = countryStatus(c.slug);
const S = STATUS_KO[st.level];
const q90 = st.quakes.filter((q) => BUILT_AT - q.time <= 90 * 864e5).slice(0, 20);
const older = st.quakes.filter((q) => BUILT_AT - q.time > 90 * 864e5 && q.mag >= 6).slice(0, 10);
const ds = st.disasters.filter((d) => !st.active.includes(d)).slice(0, 12);
const diff = tzDiff(c.tz);
const alarm = countryAlarm(c);
const adjusts = countryAdjusts(c);
const rate = countryRate(c);
const regionText = (r) => (/일부/.test(r) ? '일부 지역' : /전/.test(r) ? '전 지역' : r || '');
const others = COUNTRIES.filter((x) => x.region === c.region && x.slug !== c.slug);

const title = `${c.ko} 여행 정보 - 지금 가도 괜찮을까? 안전·시차·전압·긴급번호`;
const desc = `${c.ko} 여행 전 확인할 것: 지금 안전 상태(지진·태풍·재난 경보), ${tzDiffText(diff)}, ${c.currency}, ${c.volt} ${c.plug}, 긴급번호 ${c.emergency.map((e) => e[1]).join('·')}. (${kstDate(BUILT_AT)} 기준)`;
---
<Base title={title} desc={desc}>
  <p class="crumb"><a href="/">홈</a> › <a href="/country/">나라별</a> › {c.ko}</p>

  <section class="chero" style={`--c1:${c.color[0]};--c2:${c.color[1]}`}>
    <span class="hflag">{c.flag}</span>
    <div>
      <h1>{c.ko} 여행 정보</h1>
      <p class="hcities">{c.cities.join(' · ')}</p>
    </div>
    <div class="hclock">
      <span class="hl">현지 시각 {c.tzLabel ? `(${c.tzLabel})` : ''}</span>
      <b data-tz={c.tz} data-full="1">&nbsp;</b>
      <span class="hl">{tzDiffText(diff)}</span>
    </div>
  </section>

  <section class={`status card s-${st.level}`}>
    <div class="shead">
      <span class={`badge b-${st.level}`}>{S.label}</span>
      <b>{S.note}</b>
    </div>
    {st.maxQ && (
      <p class="muted">30일 동안 가장 큰 지진: <a href={`/quake/${st.maxQ.id}/`}>규모 {st.maxQ.mag.toFixed(1)} · {translatePlace(st.maxQ.place)}</a> ({kstDate(st.maxQ.time)})</p>
    )}
    <p class="muted">자연재난 기준 · 마지막 업데이트 {kstDateTime(BUILT_AT)} (한국 시간)</p>
    <div class="mofa">
      <div class="mofa-l">
        <span class="tl">외교부 여행경보</span>
        {alarm && alarm.levels.length ? (
          <ul class="alv">
            {alarm.levels.map((l) => (
              <li><span class={`mchip ${ALARM_KO[l.lvl].cls}`}>{l.lvl}단계 {ALARM_KO[l.lvl].label}</span> {regionText(l.region)}{l.note && <small> — {l.note}</small>}
                <small class="act">{ALARM_KO[l.lvl].act}</small></li>
            ))}
          </ul>
        ) : HAS_ALARMS ? (
          <p class="alv-none">지금 {c.ko}에 내려진 외교부 여행경보는 없어요.</p>
        ) : (
          <p class="alv-none">치안·테러·여행경보 단계는 외교부가 공식 안내예요.</p>
        )}
        {alarm?.date && <small class="muted">외교부 기준일 {alarm.date}</small>}
      </div>
      <a class="btn" href={MOFA_URL} target="_blank" rel="noopener">외교부 해외안전여행 ↗</a>
    </div>
  </section>

  {st.active.length > 0 && (
    <>
      <h2>🚨 지금 {c.ko} 재난 경보</h2>
      <div class="grid">{st.active.map((d) => <DisasterCard d={d} />)}</div>
    </>
  )}

  {adjusts.length > 0 && (
    <>
      <h2>📢 {c.ko} 여행경보 조정 소식 <small>외교부</small></h2>
      <ul class="adj card">
        {adjusts.map((a) => <li><b>{a.title}</b> <small class="muted">{a.date}</small></li>)}
      </ul>
    </>
  )}

  <h2>🧳 여행 기본 정보</h2>
  <div class="tiles">
    <div class="tile"><span class="ti">🕐</span><span class="tl">시차</span><b>{tzDiffText(diff)}</b>{c.tzLabel && <small>{c.tzLabel} · 서머타임 자동 반영</small>}</div>
    <div class={`tile ${rate ? 'rate' : ''}`}><span class="ti">💱</span><span class="tl">통화{rate ? ' · 오늘 환율' : ''}</span><b>{c.currency}</b>
      {rate && <><b class="rv">{rate.line1}</b><small>{rate.line2}</small><small>한국은행 매매기준율 · {rate.date}</small></>}
    </div>
    <div class="tile"><span class="ti">🔌</span><span class="tl">전압·플러그</span><b>{c.volt} · {c.plug}</b>
      <small class={c.adapter ? 'need' : 'ok'}>{c.adapter ? '변환 어댑터 필요' : '한국 플러그 대부분 사용 가능'}</small>
      {c.adapterNote && <small>{c.adapterNote}</small>}
    </div>
    <div class="tile"><span class="ti">🗣️</span><span class="tl">언어</span><b>{c.lang}</b></div>
    <div class="tile"><span class="ti">🏛️</span><span class="tl">수도</span><b>{c.capital}</b></div>
    {c.flight && <div class="tile"><span class="ti">✈️</span><span class="tl">인천에서 직항</span><b>{c.flight}</b></div>}
  </div>

  <h2>📞 긴급 연락처</h2>
  <div class="tiles">
    {c.emergency.map(([n, num]) => (
      <a class="tile call" href={`tel:${num}`}><span class="tl">{n}</span><b class="num">{num}</b></a>
    ))}
    <a class="tile call" href={`tel:${CONSULAR_CALL.replace(/-/g, '')}`}><span class="tl">영사콜센터 (24시간, 한국어)</span><b class="num">{CONSULAR_CALL}</b></a>
  </div>

  <h2>🌐 최근 {c.ko} 지진 <small>최근 90일 · 규모 4.5 이상</small></h2>
  <ul class="qlist">
    {q90.length ? q90.map((q) => <QuakeRow q={q} />) : <li class="empty">최근 90일 동안 규모 4.5 이상 지진 기록이 없어요.</li>}
  </ul>

  {older.length > 0 && (
    <>
      <h2>📁 지난 큰 지진 <small>규모 6 이상</small></h2>
      <ul class="qlist">{older.map((q) => <QuakeRow q={q} />)}</ul>
    </>
  )}

  {ds.length > 0 && (
    <>
      <h2>📋 {c.ko} 재난 경보 기록</h2>
      <div class="grid">{ds.map((d) => <DisasterCard d={d} />)}</div>
    </>
  )}

  <h2>✅ 출발 전 체크리스트</h2>
  <ul class="check card">
    <li>외교부 해외안전여행 앱에서 <b>동행서비스</b>를 신청하면 현지 안전 소식을 받을 수 있어요.</li>
    <li>여행자보험에 자연재해로 인한 일정 취소·지연이 보장되는지 미리 확인하세요.</li>
    {c.adapter && <li>{c.plug} 콘센트용 <b>변환 어댑터</b>를 챙기세요.</li>}
    <li>지진이 나면 숙소·항공사 공지를 먼저 확인하세요. 큰 지진 뒤에는 여진이 이어질 수 있어요.</li>
    <li>"쓰나미 안내" 표시가 있으면 바닷가 일정은 현지 기상 당국 발표를 확인한 뒤 움직이세요.</li>
  </ul>

  {others.length > 0 && (
    <>
      <h2>🗺️ 비슷한 여행지</h2>
      <div class="others">{others.map((o) => <a href={`/country/${o.slug}/`}>{o.flag} {o.ko}</a>)}</div>
    </>
  )}

  <p class="muted" style="margin-top:22px">전압·긴급번호 같은 기본 정보는 바뀔 수 있어요. 출발 전에 외교부 안내로 한 번 더 확인하세요.</p>
</Base>

<style>
  .chero {
    display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center;
    margin-top: 10px; padding: 26px 22px; border-radius: 22px; color: #fff;
    background: radial-gradient(circle at 95% 0%, rgba(255,255,255,.28) 0 90px, transparent 91px), linear-gradient(135deg, var(--c1), var(--c2));
  }
  .hflag { font-size: 54px; line-height: 1; filter: drop-shadow(0 3px 6px rgba(0,0,0,.2)); }
  .chero h1 { margin: 0; font-size: 28px; text-shadow: 0 1px 2px rgba(0,0,0,.15); }
  .hcities { margin: 2px 0 0; opacity: .92; font-weight: 500; }
  .hclock { display: flex; flex-direction: column; align-items: flex-end; background: rgba(255,255,255,.18); border-radius: 14px; padding: 10px 14px; }
  .hclock b { font-size: 20px; }
  .hl { font-size: 12px; opacity: .9; }

  .status { display: flex; flex-direction: column; gap: 6px; margin-top: 14px; }
  .shead { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .shead .badge { font-size: 14px; padding: 5px 12px; }
  .status p { margin: 0; }
  .status a:not(.btn) { color: var(--sea); }
  .s-alert { border-color: #f1b3b4; background: #fff5f5; }
  .s-watch { border-color: #f4cfa8; background: #fffaf3; }
  .mofa-l { display: flex; flex-direction: column; gap: 4px; }
  .alv { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .alv li { font-weight: 600; }
  .alv .act { display: block; color: var(--sub); font-weight: 500; }
  .alv-none { margin: 0; }
  .adj { margin: 0; padding-left: 34px; }
  .adj li { margin: 4px 0; }
  .mofa { display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap; border-top: 1px dashed var(--line); margin-top: 8px; padding-top: 12px; font-size: 14px; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .tile { display: flex; flex-direction: column; gap: 2px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px; text-decoration: none; }
  .ti { font-size: 20px; }
  .tl { font-size: 12.5px; color: var(--sub); font-weight: 600; }
  .tile b { font-size: 16px; line-height: 1.4; }
  .tile small { font-size: 12.5px; color: var(--sub); }
  .tile small.need { color: var(--coral); font-weight: 700; }
  .tile small.ok { color: var(--green); font-weight: 700; }
  .rate { border-color: #d6ead9; background: #f5fbf6; }
  .rv { color: var(--green); }
  .call { border-color: #cfe5f4; background: #f5fbff; }
  .call:hover { border-color: var(--sea); }
  .num { color: var(--sea); font-size: 20px !important; letter-spacing: .02em; }

  .check { margin: 0; padding-left: 34px; }
  .check li { margin: 5px 0; }
  .others { display: flex; flex-wrap: wrap; gap: 8px; }
  .others a { text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 7px 13px; font-weight: 600; font-size: 14px; }
  .others a:hover { border-color: var(--sea); color: var(--sea); }

  @media (max-width: 620px) {
    .chero { grid-template-columns: auto 1fr; padding: 20px 16px; }
    .hflag { font-size: 42px; }
    .chero h1 { font-size: 23px; }
    .hclock { grid-column: 1 / -1; flex-direction: row; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .tiles { grid-template-columns: 1fr 1fr; }
  }
</style>

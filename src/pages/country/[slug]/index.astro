---
import Updated from '../../../components/Updated.astro';
import HolidayBox from '../../../components/HolidayBox.astro';
import Base from '../../../layouts/Base.astro';
import CountryShell from '../../../components/CountryShell.astro';
import Flag from '../../../components/Flag.astro';
import { COUNTRIES, flagOf, tzDiff, tzDiffText, CONSULAR_CALL } from '../../../data/countries.js';
import { cityPhoto } from '../../../data/photos.js';
import { countryStatus, STATUS_KO, countryAlarm, ALARM_KO, HAS_ALARMS, countryRate, countryAdjusts, BUILT_AT } from '../../../data/load.js';
import { translatePlace, kstShort } from '../../../data/place.js';
import { CITIES } from '../../../data/cities.js';
import { HAS_CLIMATE, climateOf, travelScore, scoreLabel, t1 } from '../../../data/weather.js';
import { GUIDES } from '../../../data/guides.js';
import { kstDate } from '../../../data/place.js';
import { entryOf, KIND_KO } from '../../../data/entry.js';

export function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const st = countryStatus(c.slug);
const S = STATUS_KO[st.level];
const alarm = countryAlarm(c);
const rate = countryRate(c);
const diff = tzDiff(c.tz);
const en = entryOf(c.slug);
const nowM = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
const wc = CITIES.filter((x) => x.country === c.slug && HAS_CLIMATE(x.slug)).map((x) => {
  const d = climateOf(x.slug).m[nowM - 1];
  return { x, d, s: scoreLabel(travelScore(d)) };
});
const guides = GUIDES.map((g) => CITIES.find((x) => x.slug === g.city)).filter((x) => x && x.country === c.slug);
const adjusts = countryAdjusts(c, 3);
const bigQ = st.quakes.filter((q) => q.mag >= 5 && BUILT_AT - q.time <= 90 * 864e5).slice(0, 3);
const others = COUNTRIES.filter((x) => x.region === c.region && x.slug !== c.slug);
const partial = alarm && alarm.levels.length && alarm.levels.every((l) => /일부/.test(l.region));

const title = `${c.ko} 여행 정보 모아보기 - 안전·날씨·환율·가이드`;
const desc = `${c.ko} 여행 전 한눈에: 안전 상태, 외교부 여행경보, ${nowM}월 날씨, ${tzDiffText(diff)}, ${c.volt} ${c.plug}${rate ? `, 환율 ${rate.line1}` : ''}.`;
---
<Base title={title} desc={desc}>
  <CountryShell c={c}>
    {guides.length > 0 && (
      <>
        <h2 class="gtop">📖 {c.ko} 여행가이드</h2>
        <div class="gcards">
          {guides.map((x) => {
            const p = cityPhoto(x.slug);
            return (
              <a class="gcard" href={`/guide/${x.slug}/`}>
                <span class:list={['gimg', 'hasbg', { photo: p }]} style={`--c1:${c.color[0]};--c2:${c.color[1]}`}>{p && <img class="bgimg" src={p.src(400, 220)} alt={x.ko} loading="lazy" />}</span>
                <b>{x.ko} 여행가이드</b>
              </a>
            );
          })}
        </div>
      </>
    )}

    <section class="sumgrid">
      <a class={`card sbox s-${st.level}`} href={`/country/${c.slug}/safety/`}>
        <span class="tl">자연재난</span>
        <span class={`badge b-${st.level}`}>{S.label}</span>
        <small>{S.note}</small>
      </a>
      <a class="card sbox" href={`/country/${c.slug}/safety/`}>
        <span class="tl">외교부 여행경보</span>
        {alarm && alarm.max ? (
          <span class={`mchip ${ALARM_KO[alarm.max].cls}`}>{partial ? '일부 지역 ' : ''}최고 {alarm.max}단계 {ALARM_KO[alarm.max].label}</span>
        ) : (
          <b>{HAS_ALARMS ? '내려진 경보 없음' : '외교부 안내 확인'}</b>
        )}
        <small>지역별 단계 보기 →</small>
      </a>
    </section>
    <Updated />

    <h2>⚡ 한눈에</h2>
    <div class="tiles">
      {en && <a class="tile" href={`/country/${c.slug}/info/`}><span class="tl">입국</span><b>{en.stay}</b><small class={en.kind === 'free' && !en.musts.length ? 'ok' : 'need'}>{en.musts.length ? `출발 전 ${en.musts.length}가지 준비 →` : en.kind === 'free' ? '미리 신청할 것 없음' : '입국 안내 보기 →'}</small></a>}
      <a class="tile" href={`/country/${c.slug}/info/`}><span class="tl">시차{c.tzLabel && ` (${c.tzLabel})`}</span><b>{tzDiffText(diff)}</b></a>
      <a class={`tile ${rate ? 'rate' : ''}`} href={`/country/${c.slug}/info/`}><span class="tl">환율</span><b class={rate ? 'rv' : ''}>{rate ? rate.line1 : c.currency}</b>{rate && <small>{rate.line2}</small>}</a>
      <a class="tile" href={`/country/${c.slug}/info/`}><span class="tl">전압·플러그</span><b>{c.volt} · {c.plug}</b><small class={c.adapter ? 'need' : 'ok'}>{c.adapter ? '변환 어댑터 필요' : '한국 플러그 대부분 사용 가능'}</small></a>
      {c.flight && <a class="tile" href={`/country/${c.slug}/info/`}><span class="tl">인천에서 직항</span><b>{c.flight}</b></a>}
    </div>

    {wc.length > 0 && (
      <>
        <h2>🌤️ 지금({nowM}월) 날씨</h2>
        <div class="wrow">
          {wc.map(({ x, d, s }) => (
            <a class="card wbox" href={`/weather/${x.slug}/${nowM}/`}>
              <b>{x.ko}</b>
              <span class="tmp"><span class="lo">{t1(d.lo)}</span> ~ <span class="hi">{t1(d.hi)}</span></span>
              <span class={`sc ${s.cls}`}>{s.label}</span>
            </a>
          ))}
        </div>
        <a class="more" href={`/country/${c.slug}/weather/`}>도시별 월별 날씨 전체 →</a>
      </>
    )}

    <HolidayBox c={c} />

    {(adjusts.length > 0 || bigQ.length > 0) && (
      <>
        <h2>📢 최근 안전 소식</h2>
        <ul class="qlist">
          {adjusts.map((a) => <li><a class="qrow" href={`/country/${c.slug}/safety/`}><span><span class="t">{a.title}</span><br /><span class="s">{a.date} · 외교부</span></span></a></li>)}
          {bigQ.map((q) => <li><a class="qrow" href={`/quake/${q.id}/`}><span class="mag yellow">{q.mag.toFixed(1)}</span><span><span class="t">{translatePlace(q.place)} 지진</span><br /><span class="s">{kstShort(q.time)} (한국 시간)</span></span></a></li>)}
        </ul>
        <a class="more" href={`/country/${c.slug}/safety/`}>안전 정보 전체 →</a>
      </>
    )}

    <h2>📞 긴급 연락처</h2>
    <div class="calls">
      {c.emergency.map(([n, num]) => <a href={`tel:${num}`}><span>{n}</span><b>{num}</b></a>)}
      <a href={`tel:${CONSULAR_CALL.replace(/-/g, '')}`}><span>영사콜센터</span><b>{CONSULAR_CALL}</b></a>
    </div>

    <h2>✅ 출발 전 체크리스트</h2>
    <ul class="card list">
      {en && en.musts.length > 0 && <li>출발 전 꼭 할 일: <b>{en.musts.map((m) => m.t.replace(/ \(.*\)$/, '')).join(', ')}</b> <a href={`/country/${c.slug}/info/`}>방법 보기</a></li>}
      {en && en.until && <li>{en.until.replace(/-/g, '.')}까지 한시적으로 무비자 입국이 가능합니다. 이후 여행이라면 연장 여부를 확인하세요.</li>}
      <li>외교부 해외안전여행 앱에서 <b>동행서비스</b>를 신청하면 현지 안전 소식을 받을 수 있습니다.</li>
      <li>여행자보험에 자연재해로 인한 일정 취소·지연이 보장되는지 확인하세요.</li>
      {c.adapter && <li>{c.plug} 콘센트용 <b>변환 어댑터</b>를 챙기세요.</li>}
      <li>긴급 연락처(현지 경찰·영사콜센터)를 휴대폰에 저장해 두세요. <a href={`/country/${c.slug}/info/`}>번호 보기</a></li>
    </ul>

    {others.length > 0 && (
      <>
        <h2>🗺️ 비슷한 여행지</h2>
        <div class="chips">{others.map((o) => <a href={`/country/${o.slug}/`}><Flag iso={flagOf(o)} size={18} /> {o.ko}</a>)}</div>
      </>
    )}
    <p class="muted" style="margin-top:20px">{kstDate(Date.now())} 기준 · 기본 정보는 변경될 수 있습니다. 출발 전에 외교부 안내로 한 번 더 확인하세요.</p>
  </CountryShell>
</Base>

<style>
  .gtop { margin-top: 18px; }
  .sumgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
  .sbox { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; text-decoration: none; }
  .sbox:hover { border-color: var(--sea); }
  .sbox .badge, .sbox .mchip { font-size: 14px; padding: 5px 11px; }
  .sbox small { color: var(--sub); }
  .s-alert { border-color: #f1b3b4; background: #fff5f5; }
  .s-watch { border-color: #f4cfa8; background: #fffaf3; }
  .wrow { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .wbox { display: flex; flex-direction: column; gap: 4px; text-decoration: none; }
  .wbox:hover { border-color: var(--sea); }
  .tmp { font-weight: 700; }
  .hi { color: #d9603b; } .lo { color: #2f78c4; }
  .sc { align-self: flex-start; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  .sc.good { background: #dff3e8; color: #1d7a4c; }
  .sc.ok { background: #eef1f4; color: #55636e; }
  .sc.bad { background: #fde8e3; color: #b3452a; }
  .list a { color: var(--sea); }
  .gcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .gcard { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; text-decoration: none; }
  .gcard:hover { border-color: var(--sea); }
  .gimg { display: block; height: 110px; background: linear-gradient(135deg, var(--c1), var(--c2)); }
  .gcard b { padding: 10px 12px; }
  .calls { display: flex; flex-wrap: wrap; gap: 8px; }
  .calls a { display: inline-flex; align-items: baseline; gap: 8px; text-decoration: none; background: #FFF8F3; border: 1px solid #F6D9C7; border-radius: 12px; padding: 9px 14px; }
  .calls span { font-size: 13px; color: var(--sub); font-weight: 600; }
  .calls b { color: var(--sea); font-size: 17px; }
  @media (max-width: 620px) {
    .sumgrid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .sbox { padding: 12px; }
    .sbox small { display: none; }
    .sbox .badge, .sbox .mchip { font-size: 12px; padding: 3px 8px; white-space: normal; }
    .wrow { grid-template-columns: 1fr 1fr; }
    .gcards { grid-template-columns: 1fr 1fr; }
    .gimg { height: 80px; }
  }
</style>

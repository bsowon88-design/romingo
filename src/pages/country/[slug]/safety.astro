---
import Base from '../../../layouts/Base.astro';
import CountryShell from '../../../components/CountryShell.astro';
import QuakeRow from '../../../components/QuakeRow.astro';
import DisasterCard from '../../../components/DisasterCard.astro';
import { COUNTRIES } from '../../../data/countries.js';
import { countryStatus, STATUS_KO, BUILT_AT, countryAlarm, countryAdjusts, ALARM_KO, HAS_ALARMS } from '../../../data/load.js';
import { translatePlace, kstDateTime, kstDate } from '../../../data/place.js';
import { MOFA_URL } from '../../../site.js';
import { CITIES } from '../../../data/cities.js';
import { citySafety, QUAKE_KM } from '../../../data/near.js';
import { guideByCity } from '../../../data/guides.js';
import { TYPE_KO } from '../../../data/normalize.js';
import Updated from '../../../components/Updated.astro';

export function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const st = countryStatus(c.slug);
const S = STATUS_KO[st.level];
const alarm = countryAlarm(c);
const adjusts = countryAdjusts(c, 8);
const q90 = st.quakes.filter((q) => BUILT_AT - q.time <= 90 * 864e5).slice(0, 20);
const older = st.quakes.filter((q) => BUILT_AT - q.time > 90 * 864e5 && q.mag >= 6).slice(0, 10);
const ds = st.disasters.filter((d) => !st.active.includes(d)).slice(0, 12);
const cityRows = CITIES.filter((x) => x.country === c.slug).map((x) => ({ x, s: citySafety(x) }));
const cityHref = (x) => (guideByCity[x.slug] ? `/guide/${x.slug}/#city-safety` : `/weather/${x.slug}/#city-safety`);
const regionText = (r) => (/일부/.test(r) ? '일부 지역' : /전/.test(r) ? '전 지역' : r || '');
---
<Base title={`${c.ko} 안전 정보 - 외교부 여행경보·지진·재난`} desc={`${c.ko} 외교부 여행경보 단계와 지역, 최근 경보 조정 소식, 지진·태풍 등 재난 정보를 정리했어요.`}>
  <CountryShell c={c} tab="safety">
    <h2>외교부 여행경보</h2>
    <div class="card mofa">
      {alarm && alarm.levels.length ? (
        <ul class="alv">
          {alarm.levels.map((l) => (
            <li>
              <span class={`mchip ${ALARM_KO[l.lvl].cls}`}>{l.lvl}단계 {ALARM_KO[l.lvl].label}</span> <b>{regionText(l.region)}</b>
              {l.note && <p class="note-r">{l.note}</p>}
              <small class="act">→ {ALARM_KO[l.lvl].act}</small>
            </li>
          ))}
        </ul>
      ) : (
        <p class="none">{HAS_ALARMS ? `지금 ${c.ko}에 내려진 외교부 여행경보는 없어요.` : '여행경보 단계는 외교부 해외안전여행에서 확인하세요.'}</p>
      )}
      <a class="btn" href={MOFA_URL} target="_blank" rel="noopener">외교부 해외안전여행 ↗</a>
    </div>

    {adjusts.length > 0 && (
      <>
        <h2>여행경보 조정 소식</h2>
        <ul class="qlist">
          {adjusts.map((a) => <li><div class="qrow"><span><span class="t">{a.title}</span><br /><span class="s">{a.date} · 외교부</span></span></div></li>)}
        </ul>
      </>
    )}

    <h2>자연재난</h2>
    <div class={`card stat s-${st.level}`}>
      <span class={`badge b-${st.level}`}>{S.label}</span> <b>{S.note}</b>
      {st.maxQ && <p class="muted">30일 동안 가장 큰 지진: <a href={`/quake/${st.maxQ.id}/`}>규모 {st.maxQ.mag.toFixed(1)} · {translatePlace(st.maxQ.place)}</a> ({kstDate(st.maxQ.time)})</p>}
      <Updated />
    </div>

    {cityRows.length > 0 && (
      <>
        <h2>도시별 안전 <small>반경 {QUAKE_KM}km · 최근 30일</small></h2>
        <div class="crows">
          {cityRows.map(({ x, s }) => (
            <a class="crow" href={cityHref(x)}>
              <b>{x.ko}</b>
              <span class={`badge b-${s.level}`}>{STATUS_KO[s.level].tag}</span>
              <span class="cdesc">
                지진 {s.quakes.length}건{s.maxQ ? ` (최대 ${s.maxQ.mag.toFixed(1)}, ${s.maxQ.km}km)` : ''}
                {s.disasters.length ? ` · ${TYPE_KO[s.disasters[0].type]} 경보 ${s.disasters[0].km}km` : ' · 재난 경보 없음'}
              </span>
            </a>
          ))}
        </div>
      </>
    )}

    {st.active.length > 0 && (
      <>
        <h2>지금 재난 경보</h2>
        <div class="grid">{st.active.map((d) => <DisasterCard d={d} />)}</div>
      </>
    )}

    <h2>최근 지진 <small>최근 90일 · 규모 4.5 이상</small></h2>
    <ul class="qlist">
      {q90.length ? q90.map((q) => <QuakeRow q={q} />) : <li class="empty">최근 90일 동안 규모 4.5 이상 지진 기록이 없어요.</li>}
    </ul>

    {older.length > 0 && (
      <>
        <h2>지난 큰 지진 <small>규모 6 이상</small></h2>
        <ul class="qlist">{older.map((q) => <QuakeRow q={q} />)}</ul>
      </>
    )}

    {ds.length > 0 && (
      <>
        <h2>재난 경보 기록</h2>
        <div class="grid">{ds.map((d) => <DisasterCard d={d} />)}</div>
      </>
    )}
  </CountryShell>
</Base>

<style>
  .mofa { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .alv { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .alv li { padding-bottom: 10px; border-bottom: 1px dashed var(--line); }
  .alv li:last-child { border-bottom: 0; padding-bottom: 0; }
  .note-r { margin: 4px 0 2px; font-size: 14.5px; }
  .act { color: var(--sub); }
  .none { margin: 0; font-weight: 600; }
  .stat p { margin: 6px 0 0; }
  .stat a { color: var(--sea); }
  .crows { display: flex; flex-direction: column; gap: 6px; }
  .crow { display: grid; grid-template-columns: 90px auto 1fr; gap: 10px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; text-decoration: none; color: inherit; }
  .crow:hover { border-color: var(--coral); }
  .cdesc { font-size: 13.5px; color: var(--sub); }
  @media (max-width: 560px) { .crow { grid-template-columns: auto auto; } .cdesc { grid-column: 1 / -1; } }
  .s-alert { border-color: #f1b3b4; background: #fff5f5; }
  .s-watch { border-color: #f4cfa8; background: #f2f6f9; }
</style>

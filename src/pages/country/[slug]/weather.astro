---
import Base from '../../../layouts/Base.astro';
import CountryShell from '../../../components/CountryShell.astro';
import { COUNTRIES } from '../../../data/countries.js';
import { CITIES } from '../../../data/cities.js';
import { HAS_CLIMATE, climateOf, bestMonths, travelScore, scoreLabel, MONTHS, t1 } from '../../../data/weather.js';

export function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const nowM = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
const cities = CITIES.filter((x) => x.country === c.slug && HAS_CLIMATE(x.slug));
---
<Base title={`${c.ko} 날씨 - 도시별 월별 기온·여행하기 좋은 달`} desc={`${c.ko} ${cities.map((x) => x.ko).join(', ')}의 월별 날씨와 여행하기 좋은 달을 확인하세요.`}>
  <CountryShell c={c} tab="weather">
    {cities.length ? cities.map((x) => {
      const cl = climateOf(x.slug);
      const best = bestMonths(x.slug);
      return (
        <section class="card wc">
          <div class="wh">
            <h2><a href={`/weather/${x.slug}/`}>{x.ko}</a></h2>
            <span class="muted">여행하기 좋은 달 <b class="best">{best.map((m) => `${m}월`).join(' · ')}</b></span>
          </div>
          <div class="mgrid">
            {MONTHS.map((m) => {
              const d = cl.m[m - 1];
              const s = scoreLabel(travelScore(d));
              return (
                <a class={`mc ${s.cls} ${m === nowM ? 'now' : ''}`} href={`/weather/${x.slug}/${m}/`}>
                  <span class="mm">{m}월</span>
                  <span class="hi">{t1(d.hi)}</span>
                  <span class="lo">{t1(d.lo)}</span>
                </a>
              );
            })}
          </div>
        </section>
      );
    }) : <p class="card empty">{c.ko} 도시 날씨는 준비 중이에요.</p>}
    <p class="muted" style="margin-top:14px">칸 색: 초록 = 여행하기 좋아요, 회색 = 무난해요, 주황 = 조금 아쉬워요. 숫자는 평균 최고·최저 기온이에요.</p>
  </CountryShell>
</Base>

<style>
  .wc { margin-top: 14px; }
  .wh { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 6px; }
  .wh h2 { margin: 0; }
  .wh h2 a { text-decoration: none; }
  .best { color: var(--sea); }
  .mgrid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; margin-top: 10px; }
  .mc { display: flex; flex-direction: column; align-items: center; padding: 6px 0; border-radius: 8px; text-decoration: none; font-size: 12.5px; border: 2px solid transparent; }
  .mc.good { background: #e3f4ea; } .mc.ok { background: #eef1f4; } .mc.bad { background: #fdebe5; }
  .mc.now { border-color: var(--sea); }
  .mm { font-weight: 800; }
  .hi { color: #d9603b; font-weight: 700; } .lo { color: #2f78c4; }
  @media (max-width: 620px) { .mgrid { grid-template-columns: repeat(6, 1fr); } }
</style>

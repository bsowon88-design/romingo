---
import Base from '../layouts/Base.astro';
import { allPhotos } from '../data/photos.js';
import { bySlug } from '../data/countries.js';
import { cityBySlug } from '../data/cities.js';

const list = allPhotos().map((p) => {
  const [kind, slug] = p.key.split(':');
  const name = kind === 'country' ? bySlug[slug]?.ko : cityBySlug[slug]?.ko;
  return { ...p, place: name || slug };
});
---
<Base title="사진 출처" desc="트립베리에 쓰인 사진의 작가와 출처" noindex>
  <h1>사진 출처</h1>
  <p class="lead">트립베리의 나라·도시 사진은 <a href="https://unsplash.com/?utm_source=romingo&utm_medium=referral" target="_blank" rel="noopener">Unsplash</a> 작가들의 사진이에요. 고맙습니다.</p>
  <ul class="card cr">
    {list.map((p) => (
      <li><b>{p.place}</b> — <a href={p.page} target="_blank" rel="noopener">사진</a> by <a href={p.userUrl} target="_blank" rel="noopener">{p.name}</a> on Unsplash</li>
    ))}
  </ul>
</Base>

<style>
  .cr { margin-top: 14px; padding-left: 34px; }
  .cr li { margin: 4px 0; }
  .cr a, .lead a { color: var(--sea); }
</style>

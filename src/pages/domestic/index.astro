---
// 국내여행 첫 화면 — 이번 주말 축제 · 주말 날씨 · 지역 · 요즘 가기 좋은 곳 · 다가오는 축제
import Base from '../../layouts/Base.astro';
import FestCard from '../../components/kr/FestCard.astro';
import PlaceCard from '../../components/kr/PlaceCard.astro';
import '../../components/kr/kr.css';
import { KR_REGIONS, PLACES, festWeekend, festNow, placesOfRegion, imgUrl, WEEKEND, fmtDW, THEMES, themeOf, KR_READY } from '../../data/domestic.js';

const weekend = festWeekend();
const nowList = festNow();
// 지역 대표 사진 — 그 지역에서 점수가 가장 높은 곳
const regions = KR_REGIONS.map((r) => {
  const ps = placesOfRegion(r.slug).sort((a, b) => b.sc - a.sc);
  return { r, img: ps[0]?.img || '', n: ps.length };
});
// 계절에 맞는 묶음 3개
const m = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
const SEASON = m >= 6 && m <= 8 ? ['sea', 'valley', 'forest'] : m >= 9 && m <= 11 ? ['mountain', 'forest', 'history'] : m >= 3 && m <= 5 ? ['forest', 'walk', 'history'] : ['fun', 'view', 'culture'];
const SEASON_TITLE = {
  sea: '🏖️ 바다·섬', valley: '💦 계곡·폭포', forest: '🌲 숲·수목원', mountain: '⛰️ 산·국립공원', history: '🏯 역사·한옥',
  view: '🌉 전망대·다리', fun: '🎡 테마파크·체험', culture: '🖼️ 박물관·미술관', walk: '🚶 거리·마을·걷기 길',
};
// 전국에서 고르게 — 지역마다 1곳씩 돌아가며
function spread(th, n = 8) {
  const by = {};
  for (const p of PLACES.filter((p) => themeOf(p.c3) === th).sort((a, b) => b.sc - a.sc)) (by[p.region.slug] ||= []).push(p);
  const out = [];
  for (let i = 0; out.length < n && i < 20; i++) for (const r of KR_REGIONS) { const p = by[r.slug]?.[i]; if (p && out.length < n) out.push(p); }
  return out;
}
const rows = SEASON.map((th) => [th, SEASON_TITLE[th], spread(th)]);
---
<Base title="국내여행 - 이번 주말 축제·지역별 가볼 만한 곳·날씨" desc="이번 주말 열리는 전국 축제와 지역별 가볼 만한 곳, 주말 날씨를 한곳에서. 한국관광공사 공식 자료로 매일 새로 정리해요.">
  <section class="khero">
    <p class="crumb"><a href="/">홈</a> › 국내여행</p>
    <h1>국내여행</h1>
    <p class="lead">이번 주말 어디 갈까? 전국 축제와 지역별 가볼 만한 곳, 주말 날씨까지 한 번에 살펴보세요.</p>
    <div class="kchips kq">
      <a href="#regions">🗺️ 지역별 여행</a>
      <a href="#weekend">🎉 이번 주말 축제</a>
      <a href="#weekend-wx">🌤️ 주말 날씨</a>
      <a href="/domestic/festival/">📅 축제 달력</a>
    </div>
  </section>

  {!KR_READY ? (
    <p class="kempty">⏳ 국내 여행 자료를 모으는 중이에요. 하루 안에 채워져요.</p>
  ) : (
    <>
      <h2 id="regions">🗺️ 지역별 여행</h2>
      <div class="kregions">
        {regions.map(({ r, img, n }) => (
          <a class="kreg" href={`/domestic/${r.slug}/`}>
            {img && <img src={imgUrl(img)} alt="" loading="lazy" decoding="async" width="300" height="225" />}
            <b>{r.ko}</b><small>{n}곳</small>
          </a>
        ))}
      </div>

      {rows.slice(0, 1).map(([th, title, list]) => list.length > 0 && (
        <>
          <h2>{title} <small>요즘 가기 좋은 곳</small></h2>
          <div class="kgrid f4 lim">{list.map((p) => <PlaceCard p={p} showRegion />)}</div>
        </>
      ))}

      <div class="khead" id="weekend">
        <h2>🎉 이번 주말 축제 <small>{fmtDW(WEEKEND[0])} ~ {fmtDW(WEEKEND[1])}</small></h2>
        <a class="kmore" href="/domestic/festival/">축제 달력 →</a>
      </div>
      {(weekend.length ? weekend : nowList).length ? (
        <div class="fmini">{(weekend.length ? weekend : nowList).slice(0, 8).map((f) => <FestCard f={f} mini />)}</div>
      ) : (
        <p class="kempty">이번 주말에 열리는 축제 소식이 아직 없어요. <a href="/domestic/festival/">축제 달력</a>에서 다가오는 축제를 확인해 보세요.</p>
      )}

      <section id="weekend-wx" class="wkx">
        <h2>🌤️ 이번 주말 날씨 <small>{fmtDW(WEEKEND[0])} · {fmtDW(WEEKEND[1])}</small></h2>
        <div class="wkgrid" data-wk={WEEKEND.join(',')}>
          {KR_REGIONS.map((r) => (
            <a class="wk" href={`/domestic/${r.slug}/#wx`} data-k={`kr-${r.slug}`}>
              <b>{r.ko}</b>
              <span class="wd" data-i="0">…</span>
              <span class="wd" data-i="1">…</span>
            </a>
          ))}
        </div>
        <p class="ksrcnote wknote">예보: 노르웨이 기상청(MET Norway) · 지역마다 한 지점 기준이라 산간·해안은 다를 수 있어요.</p>
      </section>

      {rows.slice(1).map(([th, title, list]) => list.length > 0 && (
        <>
          <h2>{title} <small>요즘 가기 좋은 곳</small></h2>
          <div class="kgrid f4 lim">{list.map((p) => <PlaceCard p={p} showRegion />)}</div>
        </>
      ))}

      <p class="ksrcnote">
        축제·관광지 정보와 사진: 한국관광공사 국문 관광정보(TourAPI, 공공누리) — 매일 자동으로 새로 받아 정리해요.
        일정·요금·운영 시간은 바뀔 수 있으니 가기 전에 공식 홈페이지에서 한 번 더 확인하세요.
      </p>
    </>
  )}
</Base>

<script>
  import { loadLive, sym } from '../../scripts/live';
  const grid = document.querySelector<HTMLElement>('[data-wk]');
  if (grid) {
    const days = (grid.dataset.wk || '').split(',').map((s) => `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}`);
    loadLive('forecast')
      .then((j) => {
        let any = false;
        grid.querySelectorAll<HTMLElement>('.wk').forEach((a) => {
          const list: any[] = j.c?.[a.dataset.k || ''] || [];
          a.querySelectorAll<HTMLElement>('.wd').forEach((sp) => {
            const d = list.find((x) => x[0] === days[+(sp.dataset.i || 0)]);
            if (!d) { sp.textContent = '–'; return; }
            any = true;
            const [ic, ko] = sym(d[4]);
            sp.textContent = '';
            const i = document.createElement('i'); i.textContent = ic; i.title = ko;
            const t = document.createElement('em'); t.textContent = `${Math.round(d[1])}°/${Math.round(d[2])}°`;
            sp.append(i, t);
            if (d[3] >= 1) { const r = document.createElement('u'); r.textContent = `${d[3] >= 10 ? Math.round(d[3]) : d[3]}mm`; sp.append(r); }
          });
        });
        if (!any) throw new Error('none');
      })
      .catch(() => {
        grid.closest('section')?.querySelector('.wknote')?.replaceChildren(document.createTextNode('⏳ 주말 예보를 준비하고 있어요. 몇 시간 안에 채워져요.'));
        grid.querySelectorAll('.wd').forEach((s) => (s.textContent = '–'));
      });
  }
</script>

<style>
  .khero { margin: 4px 0 8px; }
  .khero h1 { margin: 4px 0 6px; }
  .kq { margin-top: 14px; }
  h2 small { font-size: 13px; color: var(--sub); font-weight: 600; }
  .wkgrid { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 8px; }
  @media (max-width: 1023px) { .wkgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .wk { display: flex; flex-direction: column; gap: 3px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 10px 9px; text-decoration: none; color: inherit; }
  .wk:hover { border-color: var(--coral); }
  .wk b { font-size: 14.5px; }
  .wd { display: flex; align-items: center; gap: 5px; font-size: 13px; min-height: 22px; color: var(--sub); }
  .wd :global(i) { font-style: normal; font-size: 18px; }
  .wd :global(em) { font-style: normal; font-weight: 700; color: var(--ink); }
  .wd :global(u) { text-decoration: none; font-size: 11.5px; color: #2f78c4; }
  .wd[data-i='0']::before { content: '토'; font-size: 11.5px; font-weight: 800; color: var(--sea); }
  .wd[data-i='1']::before { content: '일'; font-size: 11.5px; font-weight: 800; color: var(--red); }
  .wknote { margin-top: 8px; }
  .fmini { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 1023px) { .fmini { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .fmini { grid-template-columns: 1fr; gap: 8px; } .fmini > :global(:nth-child(n+5)) { display: none; } }
  @media (max-width: 760px) {
    .wkgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 5px; }
    .wk { padding: 7px 5px 6px; gap: 1px; border-radius: 10px; }
    .wk b { font-size: 13px; }
    .wd { font-size: 11.5px; gap: 2px; min-height: 19px; letter-spacing: -0.03em; }
    .wd :global(i) { font-size: 14px; }
    .wd :global(u) { display: none; }
    .wd[data-i='0']::before, .wd[data-i='1']::before { font-size: 10.5px; }
  }
</style>

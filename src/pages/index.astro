---
import Updated from '../components/Updated.astro';
import Base from '../layouts/Base.astro';
import Flag from '../components/Flag.astro';
import CountryCard from '../components/CountryCard.astro';
import { countryCards, latestAdjusts, activeDisasters } from '../data/load.js';
import { COUNTRIES, bySlug, flagOf } from '../data/countries.js';
import { CITIES } from '../data/cities.js';
import { GUIDES } from '../data/guides.js';
import { popularCities } from '../data/popular.js';
import { cityBySlug } from '../data/cities.js';
import PhotoCredit from '../components/PhotoCredit.astro';
import { cityPhoto } from '../data/photos.js';
import Icon from '../components/Icon.astro';
import HeroStack from '../components/HeroStack.astro';
const RENEWAL_END = Date.parse('2026-11-30T23:59:59+09:00');
import VideoRow from '../components/VideoRow.astro';
import RateBoard from '../components/RateBoard.astro';
import BestNow from '../components/BestNow.astro';
import FestCard from '../components/kr/FestCard.astro';
import '../components/kr/kr.css';
import { festWeekend, festNow, festSoon } from '../data/domestic.js';

// 인기 여행지 (처음에 보이는 카드)
const POP = ['japan', 'vietnam', 'thailand', 'philippines', 'taiwan', 'china', 'guam-saipan', 'singapore'];
const warn = countryCards.filter((c) => c.st.level !== 'calm');


const nowM = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
const popTop = popularCities(8).list;
const isoSlug = {};
for (const c of COUNTRIES) for (const i of c.iso2) if (!isoSlug[i]) isoSlug[i] = c.slug;
// 국내 축제 — 이번 주말 것 먼저, 없으면 지금·곧 열리는 것
const krFest = [...festWeekend(), ...festNow(), ...festSoon(30)].filter((f, i, a) => a.findIndex((x) => x.id === f.id) === i).slice(0, 4);
const guides = GUIDES.map((g) => CITIES.find((x) => x.slug === g.city)).filter(Boolean);
// 휴대폰: 인기 12곳 + '전체 보기'를 누르면 지역 탭으로 정리된 목록
const G_GROUPS = [
  ['일본', ['japan']],
  ['동남아', ['vietnam', 'thailand', 'philippines', 'malaysia', 'singapore', 'indonesia', 'laos', 'cambodia']],
  ['중국·대만·홍콩', ['china', 'taiwan', 'hongkong', 'macau']],
  ['괌·하와이·대양주', ['guam-saipan', 'hawaii', 'australia', 'new-zealand']],
  ['유럽', ['france', 'uk', 'italy', 'spain', 'greece', 'czechia', 'switzerland', 'germany', 'turkiye']],
  ['미주', ['usa', 'canada', 'mexico']],
];
const gGroups = G_GROUPS.map(([label, cs]) => ({ label, list: guides.filter((c) => cs.includes(c.country)) }));
const gUsed = new Set(G_GROUPS.flatMap(([, cs]) => cs));
const gEtc = guides.filter((c) => !gUsed.has(c.country));
if (gEtc.length) gGroups.push({ label: '그 밖의 아시아', list: gEtc });
const gTop = guides.slice(0, 12);
// 첫 화면 '이번 주 인기' 칩 · 인기 도시 사진 카드 (실제 운항편 자료)
const chips = popTop.slice(0, 6);
const popCards = popTop.map((r) => ({ r, c: r.city ? cityBySlug[r.city] : null })).map((x) => ({ ...x, ph: x.c ? cityPhoto(x.c.slug) : null })).filter((x) => x.ph).slice(0, 4);
// 홈 아이콘 줄 — [주소, 이름, 설명, 아이콘, 색]
const QUICK = [
  ['/find/', '여행지 찾기', '시기·스타일로 찾기'],
  ['/guide/', '도시 가이드', '도시별 여행가이드'],
  ['/domestic/', '국내여행', '축제·가볼 만한 곳'],
  ['/prep/', '여행 준비', 'eSIM·보험·숙소'],
  ['/safety/', '안전 정보', '여행경보·재난·지진'],
  ['/weather/', '날씨 정보', '도시별 월별 날씨'],
  ['/videos/', '여행 영상', '한국 유튜버 영상'],
];
---
<Base bare={true}>
  {/* 리뉴얼 안내 배너 — 2026-11-30 23:59(한국 시간)이 지나면 빌드·화면 모두에서 자동으로 숨김 */}
  {Date.now() < RENEWAL_END && (
    <div class="renewal" id="renewal" data-end={RENEWAL_END} role="img" aria-label="트립베리 리뉴얼 진행 중 · 11월 28일(토) ~ 11월 30일(월)">
      <picture>
        <source media="(max-width: 760px)" srcset="/images/banner/renewal-m.webp" width="1080" height="540" />
        <img src="/images/banner/renewal-pc.webp" width="1800" height="600" alt="트립베리 리뉴얼 진행 중 · 11월 28일(토) ~ 11월 30일(월)" fetchpriority="high" />
      </picture>
    </div>
  )}
  <section class="hero">
    <div class="hero-l">
      <p class="eyebrow"><span>TRAVEL MAGAZINE</span><i></i><span>SAFETY · WEATHER · GUIDE</span></p>
      <h1>다음 <em>여행,</em><br />어디로 떠날까요?</h1>
      <p class="lead">국내·해외 여행 안전 · 날씨 · 가이드를 트립베리 한곳에서 확인하세요.</p>
      <div class="isearch">
        <label class="search">
          <input data-search-inline type="search" placeholder="나라 · 도시 · 국내 여행지 (예: 다낭, 강릉)" autocomplete="off" />
          <button type="button" id="hsgo">검색</button>
        </label>
        <div class="ires sres" hidden></div>
      </div>
      {chips.length > 0 && (
        <p class="hot">
          <b>인기 검색</b>
          {chips.map((r) => {
            const c = r.city ? cityBySlug[r.city] : null;
            return <a href={c ? `/weather/${c.slug}/${nowM}/` : '/popular/'}>{r.ko}</a>;
          })}
        </p>
      )}
      {warn.length > 0 && (
        <p class="warnline">재난 소식 확인:
          {warn.map((c, i) => <>{i ? ', ' : ' '}<a href={`/country/${c.slug}/safety/`}>{c.ko}</a></>)}
        </p>
      )}
    </div>
    <div class="hero-r">
      <HeroStack />
    </div>
  </section>

  <nav class="toc" aria-label="바로가기">
    {QUICK.map(([href, name, sub], i) => (
      <a href={href}><span class="n">{String(i + 1).padStart(2, '0')}</span><b>{name}</b><small>{sub}</small></a>
    ))}
  </nav>

  <div class="duo">
    {popCards.length > 0 && (
      <section class="gcard popc">
        <div class="sh"><div><p class="k">THIS WEEK · TOP {popCards.length}</p><h2>이번 주 인기 도시</h2></div><a class="gmoreb" href="/popular/">전체 순위 →</a></div>
        <p class="sub2">인천·김포·김해·제주 출발 운항편 기준</p>
        <div class="pgrid">
          {popCards.map(({ r, c, ph }, i) => (
            <a class="pc" href={`/weather/${c.slug}/${nowM}/`}>
              <span class="pimg hasbg"><img class="bgimg" src={ph.src(420, 300)} alt={r.ko} loading="lazy" /><span class="prk">{i + 1}</span><PhotoCredit p={ph} link={false} /></span>
              <span class="pname">{r.iso && <Flag iso={r.iso} size={16} />} <b>{r.ko}</b></span>
              <span class="muted">출발 {r.flights}편</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <section class="gcard prepc">
      <div class="sh"><div><p class="k">BEFORE YOU GO</p><h2>여행 준비 가이드</h2></div><a class="gmoreb" href="/prep/">전체 보기 →</a></div>
      <ul class="plist">
        <li><a href="/prep/"><span>eSIM · 데이터 로밍</span><i>→</i></a></li>
        <li><a href="/prep/"><span>항공권 예약</span><i>→</i></a></li>
        <li><a href="/prep/"><span>숙소 · 렌터카</span><i>→</i></a></li>
        <li><a href="/prep/"><span>투어 · 입장권</span><i>→</i></a></li>
        <li><a href="/rates/"><span>환율 · 환전 시세</span><i>→</i></a></li>
        <li><a href="/safety/"><span>안전 정보 · 여행경보</span><i>→</i></a></li>
      </ul>
    </section>
  </div>

  <section class="core" aria-label="트립베리 핵심 기능">
    <a href="/find/"><span class="cn">A</span><span class="ctx"><b>나에게 맞는 여행지 찾기</b><small>여행 시기·비행시간·여행 스타일로 찾는 여행지</small></span><i>→</i></a>
    <a href="/compare/"><span class="cn">B</span><span class="ctx"><b>여행지 비교</b><small>다낭 vs 나트랑, 어디가 더 좋을까?</small></span><i>→</i></a>
    <a href="/my/"><span class="cn">C</span><span class="ctx"><b>나의 여행</b><small>D-day·안전·날씨·준비물을 한눈에</small></span><i>→</i></a>
  </section>

  <div class="lower">
  <BestNow />

  {krFest.length > 0 && (
    <section class="krfest">
      <div class="khead">
        <h2>{festWeekend().length ? '이번 주말 국내 축제' : '국내 축제 소식'}</h2>
        <a class="kmore" href="/domestic/">국내여행 전체 →</a>
      </div>
      <div class="fmini">{krFest.map((f) => <FestCard f={f} mini />)}</div>
    </section>
  )}

  <h2 id="pop-title">인기 여행지</h2>
  <div class="grid cgrid" id="countries">
    {countryCards.map((c) => <div class:list={['cwrap', { hide: !POP.includes(c.slug) }]} data-pop={POP.includes(c.slug) ? '1' : ''}><CountryCard c={c} /></div>)}
  </div>
  <p><a class="btn ghost" href="/country/">전체 나라 보기 ({COUNTRIES.length}곳)</a></p>

  <VideoRow order={popTop.map((r) => r.city).filter(Boolean)} />

  <RateBoard />

  <div class="tools">
    <a href="/holidays/"><b>연차 꿀팁</b><span>공휴일에 연차 붙여 오래 쉬는 날 + 갈 곳</span></a>
    <a href="/airport/"><b>공항별 직항</b><span>인천·김포·김해·제주에서 바로 가는 곳</span></a>
    <a href="/videos/"><b>여행 영상</b><span>한국 유튜버가 다녀온 도시별 영상</span></a>
    <a href="/map/"><b>안전 지도</b><span>최근 지진·태풍을 지도에서</span></a>
  </div>

  {guides.length > 0 && (
    <>
      <h2>여행가이드</h2>
      <div class="chips gpc">
        {guides.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
        <a href="/guide/" class="all">전체 보기 →</a>
      </div>
      <div class="gmob" id="gmob">
        <div class="chips">
          {gTop.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
        </div>
        <button type="button" class="gmore" aria-expanded="false" aria-controls="gall">전체 {guides.length}곳 보기 ▾</button>
        <div class="gall" id="gall" hidden>
          <div class="gtabs" role="tablist">
            {gGroups.map((g, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>{g.label} <small>{g.list.length}</small></button>)}
          </div>
          {gGroups.map((g, i) => (
            <div class="chips gpanel" data-i={i} hidden={i !== 0}>
              {g.list.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
            </div>
          ))}
          <a href="/guide/" class="gpage">여행가이드 전체 페이지 →</a>
        </div>
      </div>
    </>
  )}

  <div class="two">
    {latestAdjusts.length > 0 && (
      <section>
        <h2>최근 외교부 여행경보</h2>
        <ul class="qlist">
          {latestAdjusts.slice(0, 4).map((a) => (
            <li><a class="qrow" href={isoSlug[a.iso] ? `/country/${isoSlug[a.iso]}/safety/` : '/safety/#adjust'}>
              <span><span class="t"><Flag iso={a.iso.toLowerCase()} size={16} /> {a.title}</span><br /><span class="s">{a.date}</span></span>
            </a></li>
          ))}
        </ul>
      </section>
    )}
    <section>
      <h2>안전 정보</h2>
      <div class="card sbox">
        <p>지금 주의·위험 단계 국제 재난 경보 <b>{activeDisasters.length}건</b></p>
        <p class="muted">외교부 여행경보 단계별 나라 목록, 재난 경보, 실시간 지진을 한곳에서 확인할 수 있습니다.</p>
        <p class="sbtns"><a class="btn" href="/safety/">안전 정보 보기</a> <a class="btn ghost" href="/map/">안전 지도</a></p>
        <Updated />
      </div>
    </section>
  </div>
  </div>
</Base>



<style>
  .hero { position: relative; z-index: 5; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 40px; align-items: center; padding: 34px 10px 30px; }
  .hero-l { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .eyebrow { display: flex; align-items: center; gap: 12px; margin: 0; font-size: 12px; font-weight: 800; letter-spacing: .2em; color: #0f2233; }
  .eyebrow i { flex: 0 0 38px; height: 2px; background: #ef6a2a; }
  .hero h1 { margin: 0; font-size: 56px; line-height: 1.12; letter-spacing: -0.055em; font-weight: 900; color: #0f2233; }
  .hero h1 em { font-style: normal; color: #ef6a2a; }
  .hero .lead { margin: 0; font-size: 16.5px; font-weight: 500; color: #243c4e; max-width: 30em; }
  .isearch { width: 100%; max-width: 560px; }
  .search { display: flex; align-items: stretch; width: 100%; background: #fff; border: 2px solid #0f2233; padding: 0; font: inherit; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; color: var(--ink); background: transparent; padding: 15px 18px; }
  .search button { border: 0; background: #0f2233; color: #fff; font: inherit; font-weight: 800; font-size: 15px; padding: 0 26px; cursor: pointer; }
  .search button:hover { background: #ef6a2a; }
  .search:focus-within { outline: 2px solid #ef6a2a; outline-offset: 2px; }
  .hot { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin: 0; font-size: 14.5px; }
  .hot b { font-size: 12px; letter-spacing: .14em; color: #0f2233; }
  .hot a { text-decoration: none; font-weight: 700; color: #0f2233; border-bottom: 1px solid #0f2233; }
  .hot a:hover { color: #ef6a2a; border-color: #ef6a2a; }
  .warnline { margin: 0; font-size: 14px; font-weight: 600; color: #243c4e; }
  .warnline a { color: var(--sea); }
  .hero-r { min-width: 0; }

  .toc { display: grid; grid-template-columns: repeat(7, 1fr); background: #fff; border: 1px solid #0f2233; border-top: 4px solid #0f2233; }
  .toc a { display: flex; flex-direction: column; gap: 2px; text-decoration: none; padding: 14px 16px 16px; border-left: 1px solid #d9e1e6; transition: background .15s; }
  .toc a:first-child { border-left: 0; }
  .toc a:hover { background: #0f2233; }
  .toc a:hover b, .toc a:hover small, .toc a:hover .n { color: #fff; }
  .toc .n { font-size: 12px; font-weight: 800; letter-spacing: .12em; color: #ef6a2a; }
  .toc b { font-size: 17px; letter-spacing: -0.03em; color: #0f2233; }
  .toc small { font-size: 12.5px; color: var(--sub); }

  .duo { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 14px; margin-top: 14px; }
  .gcard { background: #fff; border: 1px solid #0f2233; border-top: 4px solid #0f2233; padding: 18px 22px 22px; min-width: 0; }
  .sh { display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; }
  .sh .k { margin: 0 0 3px; font-size: 11.5px; font-weight: 800; letter-spacing: .18em; color: #ef6a2a; }
  .sh h2 { margin: 0; font-size: 24px; letter-spacing: -0.04em; font-weight: 900; display: block; color: #0f2233; }
  .sub2 { margin: 6px 0 14px; font-size: 12.5px; color: var(--sub); padding-bottom: 12px; border-bottom: 1px solid #0f2233; }
  .prepc .sh { padding-bottom: 12px; border-bottom: 1px solid #0f2233; }
  .gmoreb { font-size: 13.5px; font-weight: 800; color: #0f2233; text-decoration: none; white-space: nowrap; border-bottom: 2px solid #ef6a2a; }
  .pgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .pc { display: flex; flex-direction: column; gap: 2px; text-decoration: none; min-width: 0; }
  .pimg { display: block; height: 150px; margin-bottom: 8px; }
  .pimg .prk { position: absolute; top: 0; left: 0; z-index: 2; margin: 0; width: 30px; height: 30px; font-size: 15px; background: #0f2233; }
  .pc:hover .bgimg { transform: scale(1.05); }
  .pimg .bgimg { transition: transform .4s; }
  .pname { display: flex; align-items: center; gap: 6px; font-size: 16px; }
  .plist { list-style: none; margin: 0; padding: 0; }
  .plist li { border-bottom: 1px solid #d9e1e6; }
  .plist a { display: flex; align-items: center; justify-content: space-between; padding: 13px 2px; text-decoration: none; font-weight: 700; font-size: 16px; color: #0f2233; }
  .plist a:hover { color: #ef6a2a; padding-left: 8px; }
  .plist a { transition: padding .15s; }
  .plist i { font-style: normal; font-weight: 800; color: #ef6a2a; }

  .lower { background: #fff; border: 1px solid #0f2233; border-top: 4px solid #0f2233; padding: 4px 32px 40px; margin-top: 14px; }
  .lower :global(h2) { padding-bottom: 8px; border-bottom: 1px solid #0f2233; }
  @media (max-width: 1023px) {
    .hero { grid-template-columns: 1fr; gap: 22px; padding: 18px 4px 18px; }
    .hero h1 { font-size: 42px; }
    .toc { grid-template-columns: repeat(4, 1fr); }
    .toc a:nth-child(5) { border-left: 0; }
    .toc a:nth-child(n+5) { border-top: 1px solid #d9e1e6; }
    .duo { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero h1 { font-size: 34px; }
    .eyebrow i, .eyebrow span + i + span { display: none; }
    .toc a:nth-child(4) { border-left: 1px solid #d9e1e6; }
    .hero .lead { font-size: 14.5px; }
    .search input { padding: 13px 14px; font-size: 15px; }
    .search button { padding: 0 18px; }
    .toc a { padding: 11px 10px 12px; }
    .toc b { font-size: 14.5px; }
    .toc small { display: none; }
    .gcard { padding: 16px 14px 16px; }
    .sh h2 { font-size: 21px; }
    .pgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pimg { height: 112px; }
    .lower { padding: 2px 18px 28px; }
  }
  .cgrid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .cwrap.hide { display: none; }
  .cwrap > :global(a) { height: 100%; }
  .good { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 2px; }
  .good::-webkit-scrollbar { display: none; }
  .good > .gn { flex: 0 0 150px; scroll-snap-align: start; }
  .gn { display: flex; flex-direction: column; gap: 2px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; text-decoration: none; overflow: hidden; }
  .gnimg { display: block; height: 96px; margin: -12px -14px 8px; }
  .gn:hover { border-color: var(--sea); }
  .gnh { display: flex; align-items: center; gap: 6px; }
  .prk { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; background: var(--coral); color: #fff; font-size: 12px; font-weight: 800; margin-right: 2px; }
  .gnt { font-weight: 700; font-size: 15px; }
  .hi { color: #d9603b; } .lo { color: #2f78c4; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }

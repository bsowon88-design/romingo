---
import Base from '../layouts/Base.astro';
import QuakeRow from '../components/QuakeRow.astro';
import DisasterCard from '../components/DisasterCard.astro';
import CountryCard from '../components/CountryCard.astro';
import { quakes, bigQuakes, activeDisasters, countryCards, BUILT_AT, latestAdjusts } from '../data/load.js';
import { COUNTRIES } from '../data/countries.js';
import { MOFA_URL } from '../site.js';
import { REGIONS } from '../data/countries.js';

const recent = quakes.filter((q) => BUILT_AT - q.time <= 7 * 864e5).slice(0, 10);
const pageIds = bigQuakes.map((q) => q.id);
const warn = countryCards.filter((c) => c.st.level !== 'calm');
const isoSlug = {};
for (const c of COUNTRIES) for (const i of c.iso2) if (!isoSlug[i]) isoSlug[i] = c.slug;
---
<Base>
  <section class="hero">
    <p class="eyebrow">✈️ 해외여행 가기 전에</p>
    <h1>지금 그 나라,<br />가도 괜찮을까?</h1>
    <p class="lead">안전 상태부터 현지 시각·통화·전압·긴급번호까지 한 번에 확인하세요.</p>
    <label class="search">
      <span>🔍</span>
      <input id="csearch" type="search" placeholder="나라나 도시 이름 (예: 다낭, 오사카)" autocomplete="off" />
    </label>
    {warn.length > 0 && (
      <p class="warnline">⚠️ 지금 확인이 필요한 곳:
        {warn.map((c, i) => <>{i ? ', ' : ' '}<a href={`/country/${c.slug}/`}>{c.flag} {c.ko}</a></>)}
      </p>
    )}
  </section>

  <div id="countries">
    {REGIONS.map(([key, label]) => (
      <section class="region" data-region>
        <h2>{label}</h2>
        <div class="grid cgrid">{countryCards.filter((c) => c.region === key).map((c) => <CountryCard c={c} />)}</div>
      </section>
    ))}
    <p id="nores" class="card empty" hidden>찾는 나라가 아직 없어요. 곧 더 늘릴게요.</p>
  </div>

  <div class="two">
    <section>
      <h2>🚨 지금 재난 경보 <small>주의·위험 단계</small></h2>
      {activeDisasters.length ? (
        <div class="dstack">{activeDisasters.slice(0, 4).map((d) => <DisasterCard d={d} />)}</div>
      ) : (
        <p class="card empty">지금 주의·위험 단계의 국제 재난 경보는 없어요.</p>
      )}
      <p><a class="btn ghost" href="/disasters/">재난 경보 전체 보기</a></p>
    </section>
    <section>
      <h2>🌐 최근 지진 <small id="live-at">최근 7일 · 규모 4.5 이상</small></h2>
      <ul class="qlist" id="live-list">
        {recent.length ? recent.map((q) => <QuakeRow q={q} />) : <li class="empty">최근 7일 동안 규모 4.5 이상 지진이 없어요.</li>}
      </ul>
      <p><a class="btn ghost" href="/quakes/">큰 지진 기록 전체 보기</a></p>
    </section>
  </div>

  {latestAdjusts.length > 0 && (
    <section>
      <h2>📢 최근 외교부 여행경보 조정</h2>
      <ul class="qlist">
        {latestAdjusts.map((a) => (
          <li><a class="qrow" href={isoSlug[a.iso] ? `/country/${isoSlug[a.iso]}/` : MOFA_URL} target={isoSlug[a.iso] ? undefined : '_blank'} rel="noopener">
            <span><span class="t">{a.title}</span><br /><span class="s">{a.date} · 외교부</span></span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  <p class="note">나라 카드의 초록·주황·빨강 상태는 지진·태풍 같은 <b>자연재난</b> 기준이고, 파랑·노랑 칸은 <b>외교부 여행경보</b> 단계예요. 자세한 내용은 나라 페이지에서 확인하세요.</p>

  <script type="application/json" id="page-ids" set:html={JSON.stringify(pageIds)}></script>
</Base>

<script>
  import { USGS_WEEK, normQuake } from '../data/normalize.js';
  import { translatePlace, kstShort, magLevel, ago } from '../data/place.js';

  // 나라 검색
  const input = document.getElementById('csearch') as HTMLInputElement | null;
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-region]').forEach((sec) => {
      let n = 0;
      sec.querySelectorAll<HTMLElement>('.ccard').forEach((a) => {
        const ok = !q || (a.dataset.name || '').toLowerCase().includes(q);
        a.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      sec.hidden = n === 0;
      shown += n;
    });
    const nores = document.getElementById('nores');
    if (nores) nores.hidden = shown > 0;
  });

  // 최근 지진: 화면을 열 때마다 미국 지질조사국에서 바로 불러옴
  const list = document.getElementById('live-list');
  const at = document.getElementById('live-at');
  const ids = new Set(JSON.parse(document.getElementById('page-ids')?.textContent || '[]'));

  function row(q) {
    const li = document.createElement('li');
    const hasPage = q.mag >= 5 && ids.has(q.id);
    const a = document.createElement(q.mag >= 5 ? 'a' : 'div');
    a.className = 'qrow';
    if (hasPage) a.setAttribute('href', `/quake/${q.id}/`);
    else if (q.mag >= 5) { a.setAttribute('href', q.url); a.setAttribute('target', '_blank'); a.setAttribute('rel', 'noopener'); }
    const m = document.createElement('span');
    m.className = `mag ${magLevel(q.mag)}`;
    m.textContent = q.mag.toFixed(1);
    const body = document.createElement('span');
    const t = document.createElement('span');
    t.className = 't';
    t.textContent = translatePlace(q.place);
    if (q.tsunami) {
      const tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = '쓰나미 안내';
      t.append(tag);
    }
    const s = document.createElement('span');
    s.className = 's';
    s.textContent = `${kstShort(q.time)} (한국 시간) · ${ago(q.time)} · 깊이 ${q.depth}km`;
    body.append(t, document.createElement('br'), s);
    a.append(m, body);
    li.append(a);
    return li;
  }

  async function refresh() {
    try {
      const res = await fetch(USGS_WEEK, { cache: 'no-store' });
      if (!res.ok) return;
      const j = await res.json();
      const qs = (j.features || []).map(normQuake).sort((a, b) => b.time - a.time).slice(0, 10);
      if (!qs.length || !list) return;
      list.replaceChildren(...qs.map(row));
      if (at) at.textContent = `실시간 · ${kstShort(Date.now())} 기준`;
    } catch {
      /* 실패하면 만들 때 넣어 둔 목록 그대로 */
    }
  }
  refresh();
  setInterval(refresh, 5 * 60 * 1000);
</script>

<style>
  .hero {
    position: relative; overflow: hidden; border-radius: 22px; padding: 34px 26px 26px; color: #fff;
    background:
      radial-gradient(circle at 85% 20%, rgba(255,255,255,.25) 0 60px, transparent 61px),
      radial-gradient(circle at 92% 85%, rgba(255,255,255,.14) 0 120px, transparent 121px),
      linear-gradient(135deg, #0a84c6 0%, #12b3c9 60%, #49d1b4 100%);
  }
  .eyebrow { margin: 0 0 6px; font-weight: 700; font-size: 14px; opacity: .9; }
  .hero h1 { margin: 0 0 8px; font-size: 32px; line-height: 1.25; }
  .hero .lead { color: rgba(255,255,255,.9); margin: 0 0 18px; }
  .search { display: flex; align-items: center; gap: 8px; background: #fff; border-radius: 14px; padding: 0 14px; max-width: 520px; box-shadow: 0 8px 24px rgba(10,60,100,.18); }
  .search input { border: 0; outline: 0; font: inherit; font-size: 16px; padding: 14px 0; width: 100%; color: var(--ink); background: transparent; }
  .warnline { margin: 14px 0 0; font-size: 14px; font-weight: 600; }
  .warnline a { color: #fff; }
  .region h2 { margin-top: 28px; }
  .cgrid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; margin-top: 12px; }
  .dstack { display: grid; gap: 10px; }
  .note { margin-top: 26px; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .hero { padding: 26px 18px 20px; }
    .hero h1 { font-size: 27px; }
    .cgrid { grid-template-columns: 1fr 1fr; gap: 10px; }
  }
</style>

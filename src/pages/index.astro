---
import Updated from '../components/Updated.astro';
import Base from '../layouts/Base.astro';
import Flag from '../components/Flag.astro';
import CountryCard from '../components/CountryCard.astro';
import { countryCards, latestAdjusts, activeDisasters } from '../data/load.js';
import { COUNTRIES, bySlug, flagOf } from '../data/countries.js';
import { CITIES } from '../data/cities.js';
import { GUIDES } from '../data/guides.js';
import { popularCities } from '../data/popular.js';
import { cityBySlug } from '../data/cities.js';
import PhotoCredit from '../components/PhotoCredit.astro';
import { cityPhoto } from '../data/photos.js';
import Icon from '../components/Icon.astro';
import HeroSlider from '../components/HeroSlider.astro';
import VideoRow from '../components/VideoRow.astro';
import RateBoard from '../components/RateBoard.astro';

// 인기 여행지 (처음에 보이는 카드)
const POP = ['japan', 'vietnam', 'thailand', 'philippines', 'taiwan', 'china', 'guam-saipan', 'singapore'];
const warn = countryCards.filter((c) => c.st.level !== 'calm');


const nowM = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
const popTop = popularCities(8).list;
const isoSlug = {};
for (const c of COUNTRIES) for (const i of c.iso2) if (!isoSlug[i]) isoSlug[i] = c.slug;
const guides = GUIDES.map((g) => CITIES.find((x) => x.slug === g.city)).filter(Boolean);
---
<Base>
  <section class="hero">
    <div class="hero-l">
      <section class="intro">
        <div>
          <h1>해외 여행지 안전 · 날씨 · 가이드</h1>
          <p class="lead">안전·날씨·환율·여행가이드를 한곳에서 확인하세요.</p>
        </div>
        <div class="isearch">
          <label class="search">
            <Icon name="search" size={20} />
            <input data-search-inline type="search" placeholder="나라나 도시 이름 (예: 다낭, 오사카)" autocomplete="off" />
          </label>
          <div class="ires sres" hidden></div>
        </div>
      </section>
      {warn.length > 0 && (
        <p class="warnline">⚠️ 재난 소식 확인:
          {warn.map((c, i) => <>{i ? ', ' : ' '}<a href={`/country/${c.slug}/safety/`}><Flag iso={flagOf(c)} size={16} /> {c.ko}</a></>)}
        </p>
      )}
      {popTop.length > 0 && (
        <div class="trend">
          <p class="trend-h">이번 주 인기 도시 <a href="/popular/">전체 순위 →</a></p>
          <ol>
            {popTop.slice(0, 5).map((r, i) => {
              const c = r.city ? cityBySlug[r.city] : null;
              return (
                <li><a href={c ? `/weather/${c.slug}/${nowM}/` : '/popular/'}>
                  <span class="tn">{i + 1}</span>{r.iso && <Flag iso={r.iso} size={18} />}<b>{r.ko}</b>
                  <span class="tf">{r.flights}편{r.change ? <em class={r.change > 0 ? "up" : "down"}>{r.change > 0 ? "▲" : "▼"}{Math.abs(r.change)}%</em> : null}</span>
                </a></li>
              );
            })}
          </ol>
        </div>
      )}
    </div>
    <div class="hero-r">
      <HeroSlider />
    </div>
  </section>

  <h2 id="pop-title">🧳 인기 여행지</h2>
  <div class="grid cgrid" id="countries">
    {countryCards.map((c) => <div class:list={['cwrap', { hide: !POP.includes(c.slug) }]} data-pop={POP.includes(c.slug) ? '1' : ''}><CountryCard c={c} /></div>)}
  </div>
  <p><a class="btn ghost" href="/country/">전체 나라 보기 ({COUNTRIES.length}곳)</a></p>

  {popTop.length > 0 && (
    <>
      <h2>✈️ 이번 주 인기 도시 <small>인천·김포·김해·제주 출발 기준</small></h2>
      <div class="good">
        {popTop.map((r, i) => {
          const c = r.city ? cityBySlug[r.city] : null;
          const ph = c ? cityPhoto(c.slug) : null;
          return (
            <a class="gn" href={c ? `/weather/${c.slug}/${nowM}/` : '/popular/'}>
              {ph && <span class="gnimg hasbg"><img class="bgimg" src={ph.src(360, 200)} alt={r.ko} loading="lazy" /><PhotoCredit p={ph} link={false} /></span>}
              <span class="gnh"><span class="prk">{i + 1}</span>{r.iso && <Flag iso={r.iso} size={18} />} <b>{r.ko}</b></span>
              <span class="muted">이번 주 {r.flights}편</span>
            </a>
          );
        })}
      </div>
      <p><a class="btn ghost" href="/popular/">인기 도시 전체 순위</a></p>
    </>
  )}

  <VideoRow order={popTop.map((r) => r.city).filter(Boolean)} />

  <RateBoard />

  <div class="tools">
    <a href="/my/"><b>🧳 나의 여행</b><span>여행지·날짜 넣고 D-day·안전·날씨 한눈에</span></a>
    <a href="/compare/"><b>↔️ 여행지 비교</b><span>다낭 vs 나트랑처럼 두 도시 나란히</span></a>
    <a href="/map/"><b>🗺️ 안전 지도</b><span>최근 지진·태풍을 지도에서</span></a>
  </div>

  {guides.length > 0 && (
    <>
      <h2>📖 여행가이드</h2>
      <div class="chips">
        {guides.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
        <a href="/guide/" class="all">전체 보기 →</a>
      </div>
    </>
  )}

  <div class="two">
    {latestAdjusts.length > 0 && (
      <section>
        <h2>📢 최근 외교부 여행경보</h2>
        <ul class="qlist">
          {latestAdjusts.slice(0, 4).map((a) => (
            <li><a class="qrow" href={isoSlug[a.iso] ? `/country/${isoSlug[a.iso]}/safety/` : '/safety/#adjust'}>
              <span><span class="t"><Flag iso={a.iso.toLowerCase()} size={16} /> {a.title}</span><br /><span class="s">{a.date}</span></span>
            </a></li>
          ))}
        </ul>
      </section>
    )}
    <section>
      <h2>🚨 안전 정보</h2>
      <div class="card sbox">
        <p>지금 주의·위험 단계 국제 재난 경보 <b>{activeDisasters.length}건</b></p>
        <p class="muted">외교부 여행경보 단계별 나라 목록, 재난 경보, 실시간 지진을 한곳에서 볼 수 있어요.</p>
        <p class="sbtns"><a class="btn" href="/safety/">안전 정보 보기</a> <a class="btn ghost" href="/map/">🗺️ 안전 지도</a></p>
        <Updated />
      </div>
    </section>
  </div>
</Base>



<style>
  .hero { position: relative; isolation: isolate; }
  .trend { display: none; }
  @media (min-width: 1024px) {
    .hero { display: grid; grid-template-columns: 400px 1fr; gap: 32px; align-items: stretch; padding: 30px 0 34px; margin-top: -22px; }
    .hero::before { content: ''; position: absolute; z-index: -1; top: 0; bottom: 0; left: calc(50% - 50vw); right: calc(50% - 50vw); background: #FBEBDF; }
    .hero-l { display: flex; flex-direction: column; gap: 16px; }
    .hero .intro { flex-direction: column; align-items: stretch; gap: 16px; margin: 0; }
    .hero .intro h1 { font-size: 30px; line-height: 1.3; letter-spacing: -0.03em; }
    .hero .isearch { max-width: none; }
    .hero .warnline { margin: 0; }
    .hero-r { min-width: 0; align-self: center; }
    .hero-r :global(.hs-slide) { flex-basis: 100%; aspect-ratio: 16 / 10; }
    .trend { display: block; background: rgba(255,255,255,.75); border: 1px solid #F3D9C8; border-radius: 18px; padding: 14px 16px 10px; }
    .trend-h { display: flex; justify-content: space-between; margin: 0 0 6px; font-weight: 800; font-size: 15px; }
    .trend-h a { font-size: 13px; font-weight: 600; color: var(--sea); text-decoration: none; }
    .trend ol { list-style: none; margin: 0; padding: 0; }
    .trend li a { display: flex; align-items: center; gap: 8px; padding: 7px 2px; text-decoration: none; border-top: 1px solid #F6E6DB; font-size: 15px; }
    .trend li:first-child a { border-top: 0; }
    .trend li a:hover b { color: var(--sea); }
    .tn { width: 18px; font-weight: 800; color: var(--sea); }
    .tf { margin-left: auto; font-size: 13px; color: var(--sub); }
    .tf em { font-style: normal; margin-left: 6px; font-weight: 700; }
    .tf .up { color: #d6383a; } .tf .down { color: #2f78c4; }
    #countries.cgrid, main .cgrid { grid-template-columns: repeat(4, 1fr); gap: 14px; }
    main .good { grid-template-columns: repeat(7, 1fr); gap: 12px; }
    main .good > :nth-child(n+8) { display: none; }
    .gnimg { height: 130px; }
  }
  .intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 6px; }
  .intro h1 { margin: 0; font-size: 28px; }
  .intro .lead { margin: 4px 0 0; }
  .isearch { width: 100%; max-width: 420px; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; color: var(--ink); background: transparent; padding: 0; }
  .search { display: flex; align-items: center; gap: 10px; width: 100%; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 13px 16px; box-shadow: 0 6px 18px rgba(140,70,30,.08); font: inherit; font-size: 15.5px; color: #A8917F; cursor: text; text-align: left; }
  .search:focus-within { border-color: var(--coral); box-shadow: 0 0 0 3px rgba(232,121,74,.15); }
  .search:hover { border-color: var(--coral); color: var(--sea); }
  .warnline { margin: 12px 0 0; font-size: 14px; font-weight: 600; color: var(--sub); }
  .warnline a { color: var(--sea); }
  .cgrid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .cwrap.hide { display: none; }
  .cwrap > :global(a) { height: 100%; }
  .good { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .gn { display: flex; flex-direction: column; gap: 2px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; text-decoration: none; overflow: hidden; }
  .gnimg { display: block; height: 96px; margin: -12px -14px 8px; }
  .gn:hover { border-color: var(--sea); }
  .gnh { display: flex; align-items: center; gap: 6px; }
  .prk { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; background: var(--coral); color: #fff; font-size: 12px; font-weight: 800; margin-right: 2px; }
  .gnt { font-weight: 700; font-size: 15px; }
  .hi { color: #d9603b; } .lo { color: #2f78c4; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; font-weight: 600; font-size: 14.5px; }
  .chips a.all { color: var(--sea); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; }
  .tools { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 34px; }
  .tools a { display: flex; flex-direction: column; gap: 3px; text-decoration: none; color: inherit; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; }
  .tools a:hover { border-color: var(--coral); }
  .tools b { font-size: 16px; }
  .tools span { font-size: 13px; color: var(--sub); }
  @media (max-width: 760px) { .tools { grid-template-columns: 1fr; gap: 8px; } }
  .sbox p { margin: 0 0 8px; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .intro { gap: 10px; }
    .intro h1 { font-size: 20px; }
    .intro .lead { display: none; }
    .isearch { max-width: none; }
    .search { padding: 11px 14px; }
    .warnline { margin-top: 8px; font-size: 13px; }
    h2 { font-size: 17px; margin: 22px 0 10px; }
    .cgrid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .good { grid-template-columns: 1fr 1fr; }
  }
</style>

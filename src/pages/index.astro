---
import Base from '../layouts/Base.astro';
import QuakeRow from '../components/QuakeRow.astro';
import DisasterCard from '../components/DisasterCard.astro';
import CountryCard from '../components/CountryCard.astro';
import { quakes, bigQuakes, activeDisasters, countryCards, BUILT_AT } from '../data/load.js';

const recent = quakes.filter((q) => BUILT_AT - q.time <= 7 * 864e5).slice(0, 15);
const order = { alert: 0, watch: 1, calm: 2 };
const cards = [...countryCards].sort((a, b) => order[a.st.level] - order[b.st.level]);
const pageIds = bigQuakes.map((q) => q.id);
---
<Base>
  <section class="hero">
    <h1>지금 그 나라, 가도 괜찮을까?</h1>
    <p class="lead">여행 가는 나라의 지진·태풍·홍수·화산 소식을 공식 데이터로 자동 정리해요.</p>
  </section>

  <h2>🚨 지금 재난 경보 <small>국제 재난경보(GDACS) 주의·위험 단계</small></h2>
  {activeDisasters.length ? (
    <div class="grid">{activeDisasters.slice(0, 6).map((d) => <DisasterCard d={d} />)}</div>
  ) : (
    <p class="card empty">지금 주의·위험 단계의 국제 재난 경보는 없어요.</p>
  )}
  {activeDisasters.length > 6 && <p><a class="btn ghost" href="/disasters/">재난 경보 전체 보기</a></p>}

  <h2>🌐 최근 지진 <small id="live-at">최근 7일 · 규모 4.5 이상</small></h2>
  <ul class="qlist" id="live-list">
    {recent.length ? recent.map((q) => <QuakeRow q={q} />) : <li class="empty">최근 7일 동안 규모 4.5 이상 지진이 없어요.</li>}
  </ul>
  <p><a class="btn ghost" href="/quakes/">큰 지진 기록 전체 보기</a></p>

  <h2>🧳 나라별 안전 정보 <small>자연재난 기준</small></h2>
  <div class="grid">{cards.map((c) => <CountryCard c={c} />)}</div>
  <p class="note" style="margin-top:14px">여기 상태는 지진·태풍 같은 <b>자연재난</b>만 본 거예요. 치안, 테러, 여행경보 단계는 나라 페이지의 외교부 안내에서 확인하세요.</p>

  <script type="application/json" id="page-ids" set:html={JSON.stringify(pageIds)}></script>
</Base>

<script>
  import { USGS_WEEK, normQuake } from '../data/normalize.js';
  import { translatePlace, kstShort, magLevel, ago } from '../data/place.js';

  // 화면을 열 때마다 미국 지질조사국에서 최신 지진을 바로 불러와 목록을 바꿈
  const list = document.getElementById('live-list');
  const at = document.getElementById('live-at');
  const ids = new Set(JSON.parse(document.getElementById('page-ids')?.textContent || '[]'));

  function row(q) {
    const li = document.createElement('li');
    const hasPage = q.mag >= 5 && ids.has(q.id);
    const a = document.createElement(hasPage || q.mag >= 5 ? 'a' : 'div');
    a.className = 'qrow';
    if (hasPage) a.href = `/quake/${q.id}/`;
    else if (q.mag >= 5) { a.href = q.url; a.target = '_blank'; a.rel = 'noopener'; }
    const m = document.createElement('span');
    m.className = `mag ${magLevel(q.mag)}`;
    m.textContent = q.mag.toFixed(1);
    const body = document.createElement('span');
    const t = document.createElement('span');
    t.className = 't';
    t.textContent = translatePlace(q.place);
    if (q.tsunami) {
      const tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = '쓰나미 안내';
      t.append(tag);
    }
    const s = document.createElement('span');
    s.className = 's';
    s.textContent = `${kstShort(q.time)} (한국 시간) · ${ago(q.time)} · 깊이 ${q.depth}km`;
    body.append(t, document.createElement('br'), s);
    a.append(m, body);
    li.append(a);
    return li;
  }

  async function refresh() {
    try {
      const res = await fetch(USGS_WEEK, { cache: 'no-store' });
      if (!res.ok) return;
      const j = await res.json();
      const qs = (j.features || []).map(normQuake).sort((a, b) => b.time - a.time).slice(0, 15);
      if (!qs.length || !list) return;
      list.replaceChildren(...qs.map(row));
      if (at) at.textContent = `실시간 · 최근 7일 · 규모 4.5 이상 · ${kstShort(Date.now())} 기준`;
    } catch {
      /* 실패하면 만들 때 넣어 둔 목록 그대로 */
    }
  }
  refresh();
  setInterval(refresh, 5 * 60 * 1000);
</script>

<style>
  .hero { background: linear-gradient(135deg, #0f2a3d 0%, #127c8c 100%); color: #fff; border-radius: 18px; padding: 28px 22px; }
  .hero h1 { margin: 0 0 6px; font-size: 28px; }
  .hero .lead { color: rgba(255,255,255,.85); margin: 0; }
</style>

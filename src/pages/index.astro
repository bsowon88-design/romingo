---
import Updated from '../components/Updated.astro';
import Base from '../layouts/Base.astro';
import Flag from '../components/Flag.astro';
import CountryCard from '../components/CountryCard.astro';
import { countryCards, latestAdjusts, activeDisasters } from '../data/load.js';
import { COUNTRIES, bySlug, flagOf } from '../data/countries.js';
import { CITIES } from '../data/cities.js';
import { GUIDES } from '../data/guides.js';
import { popularCities } from '../data/popular.js';
import { cityBySlug } from '../data/cities.js';
import PhotoCredit from '../components/PhotoCredit.astro';
import { cityPhoto } from '../data/photos.js';
import Icon from '../components/Icon.astro';
import HeroStack from '../components/HeroStack.astro';
const RENEWAL_END = Date.parse('2026-11-30T23:59:59+09:00');
import VideoRow from '../components/VideoRow.astro';
import RateBoard from '../components/RateBoard.astro';
import BestNow from '../components/BestNow.astro';
import FestCard from '../components/kr/FestCard.astro';
import '../components/kr/kr.css';
import { festWeekend, festNow, festSoon } from '../data/domestic.js';

// 인기 여행지 (처음에 보이는 카드)
const POP = ['japan', 'vietnam', 'thailand', 'philippines', 'taiwan', 'china', 'guam-saipan', 'singapore'];
const warn = countryCards.filter((c) => c.st.level !== 'calm');


const nowM = +new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Seoul', month: 'numeric' }).format(new Date());
const popTop = popularCities(8).list;
const isoSlug = {};
for (const c of COUNTRIES) for (const i of c.iso2) if (!isoSlug[i]) isoSlug[i] = c.slug;
// 국내 축제 — 이번 주말 것 먼저, 없으면 지금·곧 열리는 것
const krFest = [...festWeekend(), ...festNow(), ...festSoon(30)].filter((f, i, a) => a.findIndex((x) => x.id === f.id) === i).slice(0, 4);
const guides = GUIDES.map((g) => CITIES.find((x) => x.slug === g.city)).filter(Boolean);
// 휴대폰: 인기 12곳 + '전체 보기'를 누르면 지역 탭으로 정리된 목록
const G_GROUPS = [
  ['일본', ['japan']],
  ['동남아', ['vietnam', 'thailand', 'philippines', 'malaysia', 'singapore', 'indonesia', 'laos', 'cambodia']],
  ['중국·대만·홍콩', ['china', 'taiwan', 'hongkong', 'macau']],
  ['괌·하와이·대양주', ['guam-saipan', 'hawaii', 'australia', 'new-zealand']],
  ['유럽', ['france', 'uk', 'italy', 'spain', 'greece', 'czechia', 'switzerland', 'germany', 'turkiye']],
  ['미주', ['usa', 'canada', 'mexico']],
];
const gGroups = G_GROUPS.map(([label, cs]) => ({ label, list: guides.filter((c) => cs.includes(c.country)) }));
const gUsed = new Set(G_GROUPS.flatMap(([, cs]) => cs));
const gEtc = guides.filter((c) => !gUsed.has(c.country));
if (gEtc.length) gGroups.push({ label: '그 밖의 아시아', list: gEtc });
const gTop = guides.slice(0, 12);
// 첫 화면 '이번 주 인기' 칩 · 인기 도시 사진 카드 (실제 운항편 자료)
const chips = popTop.slice(0, 6);
const popCards = popTop.map((r) => ({ r, c: r.city ? cityBySlug[r.city] : null })).map((x) => ({ ...x, ph: x.c ? cityPhoto(x.c.slug) : null })).filter((x) => x.ph).slice(0, 4);
// 홈 아이콘 줄 — [주소, 이름, 설명, 아이콘, 색]
const QUICK = [
  ['/find/', '여행지 찾기', '시기·스타일로 찾기', 'compass', '#2f78c4'],
  ['/guide/', '도시 가이드', '도시별 여행가이드', 'book-open', '#1d9a8a'],
  ['/domestic/', '국내여행', '축제·가볼 만한 곳', 'map-pin', '#e8822a'],
  ['/prep/', '여행 준비', 'eSIM·보험·숙소', 'luggage', '#7a5bc4'],
  ['/safety/', '안전 정보', '여행경보·재난·지진', 'shield-check', '#2f9e6a'],
  ['/weather/', '날씨 정보', '도시별 월별 날씨', 'cloud-sun', '#3aa0d8'],
  ['/videos/', '여행 영상', '한국 유튜버 영상', 'clapperboard', '#d6383a'],
];
---
<Base bare={true}>
  {/* 리뉴얼 안내 배너 — 2026-11-30 23:59(한국 시간)이 지나면 빌드·화면 모두에서 자동으로 숨김 */}
  {Date.now() < RENEWAL_END && (
    <div class="renewal" id="renewal" data-end={RENEWAL_END} role="img" aria-label="트립베리 리뉴얼 진행 중 · 11월 28일(토) ~ 11월 30일(월)">
      <picture>
        <source media="(max-width: 760px)" srcset="/images/banner/renewal-m.webp" width="1080" height="540" />
        <img src="/images/banner/renewal-pc.webp" width="1800" height="600" alt="트립베리 리뉴얼 진행 중 · 11월 28일(토) ~ 11월 30일(월)" fetchpriority="high" />
      </picture>
    </div>
  )}
  <section class="hero">
    <div class="hero-l">
      <p class="eyebrow">TRAVEL SAFETY × TRAVEL GUIDE</p>
      <h1>다음 <em>여행,</em> 어디로 떠날까요?</h1>
      <p class="lead">국내·해외 여행 안전 · 날씨 · 가이드를 트립베리 한곳에서 확인하세요.</p>
      <div class="isearch">
        <label class="search">
          <Icon name="search" size={20} />
          <input data-search-inline type="search" placeholder="나라·도시·국내 여행지 (예: 다낭, 강릉)" autocomplete="off" />
        </label>
        <div class="ires sres" hidden></div>
      </div>
      {chips.length > 0 && (
        <div class="hot">
          <span class="hot-l">🔥 이번 주 인기</span>
          {chips.map((r) => {
            const c = r.city ? cityBySlug[r.city] : null;
            return <a href={c ? `/weather/${c.slug}/${nowM}/` : '/popular/'}>{r.ko}</a>;
          })}
        </div>
      )}
      {warn.length > 0 && (
        <p class="warnline">⚠️ 재난 소식 확인:
          {warn.map((c, i) => <>{i ? ', ' : ' '}<a href={`/country/${c.slug}/safety/`}><Flag iso={flagOf(c)} size={16} /> {c.ko}</a></>)}
        </p>
      )}
    </div>
    <div class="hero-r">
      <HeroStack />
    </div>
  </section>

  <nav class="quick" aria-label="바로가기">
    {QUICK.map(([href, name, sub, icon, color]) => (
      <a href={href} style={`--ic:${color}`}><span class="qi"><Icon name={icon} size={30} stroke={1.7} /></span><b>{name}</b><small>{sub}</small></a>
    ))}
  </nav>

  <div class="duo">
    {popCards.length > 0 && (
      <section class="gcard popc">
        <div class="gh"><h2>이번 주 인기 도시 <small>인천·김포·김해·제주 출발 운항편 기준</small></h2><a class="gmoreb" href="/popular/">전체 순위 →</a></div>
        <div class="pgrid">
          {popCards.map(({ r, c, ph }, i) => (
            <a class="pc" href={`/weather/${c.slug}/${nowM}/`}>
              <span class="pimg hasbg"><img class="bgimg" src={ph.src(420, 300)} alt={r.ko} loading="lazy" /><span class="prk">{i + 1}</span><PhotoCredit p={ph} link={false} /></span>
              <span class="pname">{r.iso && <Flag iso={r.iso} size={16} />} <b>{r.ko}</b></span>
              <span class="muted">출발 {r.flights}편</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <section class="gcard prepc">
      <div class="gh"><h2>여행 준비 가이드</h2><a class="gmoreb" href="/prep/">전체 보기 →</a></div>
      <ul class="plist">
        <li><a href="/prep/"><i>✓</i>eSIM · 데이터 로밍</a></li>
        <li><a href="/prep/"><i>✓</i>항공권 예약</a></li>
        <li><a href="/prep/"><i>✓</i>숙소 · 렌터카</a></li>
        <li><a href="/prep/"><i>✓</i>투어 · 입장권</a></li>
        <li><a href="/rates/"><i>✓</i>환율 · 환전 시세</a></li>
        <li><a href="/safety/"><i>✓</i>안전 정보 · 여행경보</a></li>
      </ul>
    </section>
  </div>

  <section class="core" aria-label="트립베리 핵심 기능">
    <a href="/find/"><span class="cimg"><img src="/banners/find-m.webp" alt="" width="880" height="400" /></span><span class="ctx"><b><span class="pc">나에게 맞는 </span>여행지 찾기</b><small>여행 시기·비행시간·여행 스타일로 찾는 여행지</small></span></a>
    <a href="/compare/"><span class="cimg"><img src="/banners/compare-m.webp" alt="" width="880" height="400" /></span><span class="ctx"><b>여행지 비교</b><small>다낭 vs 나트랑, 어디가 더 좋을까?</small></span></a>
    <a href="/my/"><span class="cimg"><img src="/banners/my-m.webp" alt="" width="880" height="400" /></span><span class="ctx"><b>나의 여행</b><small>D-day·안전·날씨·준비물을 한눈에</small></span></a>
  </section>

  <div class="lower">
  <BestNow />

  {krFest.length > 0 && (
    <section class="krfest">
      <div class="khead">
        <h2>{festWeekend().length ? '🎉 이번 주말 국내 축제' : '🎉 국내 축제 소식'}</h2>
        <a class="kmore" href="/domestic/">국내여행 전체 →</a>
      </div>
      <div class="fmini">{krFest.map((f) => <FestCard f={f} mini />)}</div>
    </section>
  )}

  <h2 id="pop-title">🧳 인기 여행지</h2>
  <div class="grid cgrid" id="countries">
    {countryCards.map((c) => <div class:list={['cwrap', { hide: !POP.includes(c.slug) }]} data-pop={POP.includes(c.slug) ? '1' : ''}><CountryCard c={c} /></div>)}
  </div>
  <p><a class="btn ghost" href="/country/">전체 나라 보기 ({COUNTRIES.length}곳)</a></p>

  <VideoRow order={popTop.map((r) => r.city).filter(Boolean)} />

  <RateBoard />

  <div class="tools">
    <a href="/holidays/"><b>📅 연차 꿀팁</b><span>공휴일에 연차 붙여 오래 쉬는 날 + 갈 곳</span></a>
    <a href="/airport/"><b>✈️ 공항별 직항</b><span>인천·김포·김해·제주에서 바로 가는 곳</span></a>
    <a href="/videos/"><b>📺 여행 영상</b><span>한국 유튜버가 다녀온 도시별 영상</span></a>
    <a href="/map/"><b>🗺️ 안전 지도</b><span>최근 지진·태풍을 지도에서</span></a>
  </div>

  {guides.length > 0 && (
    <>
      <h2>📖 여행가이드</h2>
      <div class="chips gpc">
        {guides.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
        <a href="/guide/" class="all">전체 보기 →</a>
      </div>
      <div class="gmob" id="gmob">
        <div class="chips">
          {gTop.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
        </div>
        <button type="button" class="gmore" aria-expanded="false" aria-controls="gall">전체 {guides.length}곳 보기 ▾</button>
        <div class="gall" id="gall" hidden>
          <div class="gtabs" role="tablist">
            {gGroups.map((g, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>{g.label} <small>{g.list.length}</small></button>)}
          </div>
          {gGroups.map((g, i) => (
            <div class="chips gpanel" data-i={i} hidden={i !== 0}>
              {g.list.map((x) => <a href={`/guide/${x.slug}/`}><Flag iso={flagOf(bySlug[x.country])} size={18} /> {x.ko}</a>)}
            </div>
          ))}
          <a href="/guide/" class="gpage">여행가이드 전체 페이지 →</a>
        </div>
      </div>
    </>
  )}

  <div class="two">
    {latestAdjusts.length > 0 && (
      <section>
        <h2>📢 최근 외교부 여행경보</h2>
        <ul class="qlist">
          {latestAdjusts.slice(0, 4).map((a) => (
            <li><a class="qrow" href={isoSlug[a.iso] ? `/country/${isoSlug[a.iso]}/safety/` : '/safety/#adjust'}>
              <span><span class="t"><Flag iso={a.iso.toLowerCase()} size={16} /> {a.title}</span><br /><span class="s">{a.date}</span></span>
            </a></li>
          ))}
        </ul>
      </section>
    )}
    <section>
      <h2>🚨 안전 정보</h2>
      <div class="card sbox">
        <p>지금 주의·위험 단계 국제 재난 경보 <b>{activeDisasters.length}건</b></p>
        <p class="muted">외교부 여행경보 단계별 나라 목록, 재난 경보, 실시간 지진을 한곳에서 확인할 수 있습니다.</p>
        <p class="sbtns"><a class="btn" href="/safety/">안전 정보 보기</a> <a class="btn ghost" href="/map/">🗺️ 안전 지도</a></p>
        <Updated />
      </div>
    </section>
  </div>
  </div>
</Base>



<style>
  .hero { position: relative; z-index: 5; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 36px; align-items: center; padding: 26px 8px 22px; }
  .hero-l { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .eyebrow { margin: 0; font-size: 13px; font-weight: 800; letter-spacing: .18em; color: #2f78c4; }
  .hero h1 { margin: 0; font-size: 46px; line-height: 1.2; letter-spacing: -0.045em; font-weight: 800; color: #16324a; }
  .hero h1 em { font-style: normal; color: #ef7a2e; }
  .hero .lead { margin: 0; font-size: 16.5px; font-weight: 500; color: #35586f; }
  .isearch { width: 100%; max-width: 560px; }
  .search { display: flex; align-items: center; gap: 10px; width: 100%; background: #fff; border: 1px solid rgba(255,255,255,.9); border-radius: 999px; padding: 14px 22px; box-shadow: 0 10px 28px rgba(20,100,150,.18); font: inherit; font-size: 16px; color: #7a98ac; cursor: text; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 16px; color: var(--ink); background: transparent; padding: 0; }
  .search:focus-within { box-shadow: 0 0 0 3px rgba(239,122,46,.28), 0 10px 28px rgba(20,100,150,.18); }
  .hot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .hot-l { font-weight: 800; font-size: 14px; color: #16324a; margin-right: 2px; }
  .hot a { text-decoration: none; background: rgba(255,255,255,.88); border: 1px solid rgba(255,255,255,.9); border-radius: 999px; padding: 6px 14px; font-weight: 700; font-size: 14px; color: #24485f; box-shadow: 0 3px 10px rgba(20,100,150,.1); }
  .hot a:hover { color: #ef7a2e; }
  .warnline { margin: 0; font-size: 14px; font-weight: 600; color: #35586f; }
  .warnline a { color: var(--sea); }
  .hero-r { min-width: 0; }

  .quick { display: grid; grid-template-columns: repeat(7, 1fr); background: var(--glass); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid var(--glass-line); border-radius: 24px; box-shadow: 0 12px 34px rgba(20,100,150,.14); padding: 14px 6px; }
  .quick a { display: flex; flex-direction: column; align-items: center; gap: 3px; text-align: center; text-decoration: none; padding: 8px 4px; border-left: 1px solid rgba(40,100,140,.12); }
  .quick a:first-child { border-left: 0; }
  .quick a:hover .qi { transform: translateY(-3px); }
  .qi { display: grid; place-items: center; width: 48px; height: 48px; color: var(--ic); transition: transform .18s; }
  .quick b { font-size: 16px; letter-spacing: -0.02em; color: #1b2f3d; }
  .quick small { font-size: 12.5px; color: var(--sub); }

  .duo { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 16px; margin-top: 16px; }
  .gcard { background: var(--glass); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid var(--glass-line); border-radius: 24px; box-shadow: 0 12px 34px rgba(20,100,150,.12); padding: 18px 20px 20px; min-width: 0; }
  .gh { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .gh h2 { margin: 0; font-size: 20px; border-left: 4px solid #ef7a2e; padding-left: 10px; line-height: 1.2; display: block; }
  .gh h2 small { display: block; margin-top: 3px; font-size: 12px; }
  .gmoreb { font-size: 13.5px; font-weight: 700; color: #2f78c4; text-decoration: none; white-space: nowrap; }
  .pgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .pc { display: flex; flex-direction: column; gap: 2px; text-decoration: none; min-width: 0; }
  .pimg { display: block; height: 138px; border-radius: 14px; margin-bottom: 6px; }
  .pimg .prk { position: absolute; top: 8px; left: 8px; z-index: 2; margin: 0; }
  .pc:hover .bgimg { transform: scale(1.05); }
  .pimg .bgimg { transition: transform .4s; }
  .pname { display: flex; align-items: center; gap: 6px; font-size: 15px; }
  .plist { list-style: none; margin: 0; padding: 0; }
  .plist li + li { border-top: 1px solid rgba(40,100,140,.1); }
  .plist a { display: flex; align-items: center; gap: 10px; padding: 11px 2px; text-decoration: none; font-weight: 600; font-size: 15.5px; color: #24323d; }
  .plist a:hover { color: var(--sea); }
  .plist i { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: #ef7a2e; color: #fff; font-style: normal; font-size: 13px; font-weight: 800; flex: none; }

  .lower { background: var(--glass); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid var(--glass-line); border-radius: 26px; box-shadow: 0 14px 40px rgba(20,100,150,.12); padding: 4px 32px 40px; margin-top: 18px; }
  @media (max-width: 1023px) {
    .hero { grid-template-columns: 1fr; gap: 18px; padding: 14px 4px 14px; }
    .hero h1 { font-size: 36px; }
    .hero-r { max-width: 560px; }
    .quick { grid-template-columns: repeat(4, 1fr); row-gap: 4px; }
    .quick a:nth-child(5) { border-left: 0; }
    .duo { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero h1 { font-size: 30px; }
    .hero .lead { font-size: 14.5px; }
    .search { padding: 12px 16px; }
    .quick { padding: 10px 2px; border-radius: 20px; }
    .qi { width: 40px; height: 40px; } .qi :global(svg) { width: 26px; height: 26px; }
    .quick b { font-size: 13.5px; }
    .quick small { display: none; }
    .gcard { padding: 16px 14px 16px; border-radius: 20px; }
    .gh h2 { font-size: 18px; }
    .pgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pimg { height: 110px; }
    .lower { padding: 2px 18px 28px; border-radius: 20px; }
  }
  .cgrid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .cwrap.hide { display: none; }
  .cwrap > :global(a) { height: 100%; }
  .good { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 2px; }
  .good::-webkit-scrollbar { display: none; }
  .good > .gn { flex: 0 0 150px; scroll-snap-align: start; }
  .gn { display: flex; flex-direction: column; gap: 2px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; text-decoration: none; overflow: hidden; }
  .gnimg { display: block; height: 96px; margin: -12px -14px 8px; }
  .gn:hover { border-color: var(--sea); }
  .gnh { display: flex; align-items: center; gap: 6px; }
  .prk { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; background: var(--coral); color: #fff; font-size: 12px; font-weight: 800; margin-right: 2px; }
  .gnt { font-weight: 700; font-size: 15px; }
  .hi { color: #d9603b; } .lo { color: #2f78c4; }

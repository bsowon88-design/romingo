<script>
  const gm = document.getElementById('gmob');
  if (gm) {
    const more = gm.querySelector('.gmore');
    const all = gm.querySelector('.gall');
    const total = more.textContent.replace(' ▾', '');
    more.addEventListener('click', () => {
      const open = all.hidden;
      all.hidden = !open;
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? '접기 ▴' : `${total} ▾`;
    });
    gm.querySelectorAll('.gtabs button').forEach((b) => b.addEventListener('click', () => {
      gm.querySelectorAll('.gtabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      gm.querySelectorAll('.gpanel').forEach((p) => { p.hidden = p.dataset.i !== b.dataset.i; });
    }));
  }
</script>

<script>
  document.getElementById('hsgo')?.addEventListener('click', () => {
    const a = document.querySelector('.hero .ires a');
    if (a) location.href = a.href; else document.querySelector('[data-search-inline]')?.focus();
  });
</script>


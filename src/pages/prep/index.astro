---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import { PARTNERS, CATS, AD_NOTE } from '../../data/partners.js';
const groups = CATS.map((c) => ({ ...c, list: PARTNERS.filter((p) => p.cat === c.id) }));
---
<Base title="해외여행 준비 - eSIM·투어·숙소·렌터카 업체 비교" desc="해외여행 전에 준비할 데이터(eSIM), 투어·입장권, 숙소, 렌터카를 업체별 장점으로 비교해요.">
  <section class="pv">
    <PageBanner name="prep">
      <p class="crumb"><a href="/">홈</a> › 여행 준비</p>
      <h1>여행 준비</h1>
      <p class="lead">데이터 · 항공권 · 투어 · 숙소 · 렌터카, 업체마다 잘하는 게 달라요. 나한테 맞는 곳을 골라 보세요.</p>
    </PageBanner>
    <p class="adn"><em>광고</em> {AD_NOTE}</p>
    <nav class="pjump">{groups.map((g) => <a href={`#${g.id}`}>{g.ico} {g.name}</a>)}</nav>
  </section>

  {groups.map((g) => (
    <section class="pg" id={g.id}>
      <div class="pg-h"><h2>{g.ico} {g.name}</h2>
      <p class="muted">{g.lead}</p></div>
      <div class="pcards">
        {g.list.map((p) => (
          <article class="pc">
            <h3>{p.name}{p.only && <small>일본</small>}</h3>
            <p class="pbest">👍 {p.best}</p>
            <ul>{p.pros.map((x) => <li>{x}</li>)}</ul>
            {p.url
              ? <a class="pgo" href={p.url} target="_blank" rel="sponsored nofollow noopener">{p.name} 보러 가기 ↗</a>
              : <span class="pgo off">링크 준비 중</span>}
          </article>
        ))}
      </div>
    </section>
  ))}

  <p class="pnote">장점은 각 업체의 공식 앱 소개와 공식 사이트 안내를 바탕으로 적었어요 (2026년 11월 확인). 가격·조건은 바뀔 수 있으니 결제 전에 업체 화면에서 꼭 확인하세요.</p>
</Base>

<style>
  .adn { font-size: 13px; color: var(--sub); background: #FFF6EF; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; margin: 0 0 14px; }
  .adn em { font-style: normal; font-weight: 800; color: var(--sea); margin-right: 4px; }
  .pjump { display: flex; flex-wrap: wrap; gap: 8px; }
  .pjump a { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 14px; border: 1px solid var(--line); border-radius: 999px; padding: 7px 13px; background: #fff; }
  .pjump a:hover { border-color: var(--coral); }
  .pg { scroll-margin-top: 80px; }
  .pcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin-top: 12px; }
  .pc { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; padding: 16px 16px 14px; background: #fff; }
  .pc h3 { margin: 0; font-size: 19px; display: flex; align-items: center; gap: 8px; }
  .pc h3 small { font-size: 11.5px; font-weight: 700; color: var(--sub); border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; }
  .pbest { margin: 6px 0 8px; font-size: 14px; font-weight: 700; color: var(--sea); }
  .pc ul { margin: 0 0 14px; padding-left: 18px; font-size: 14px; line-height: 1.7; color: #4a3b33; }
  .pgo { margin-top: auto; display: block; text-align: center; text-decoration: none; font-weight: 800; color: #fff; background: var(--sea); border-radius: 12px; padding: 11px; }
  .pgo:hover { filter: brightness(1.06); }
  .pgo.off { background: #F3ECE7; color: var(--sub); font-weight: 600; }
  @media (min-width: 1024px) {
    .pg { display: grid; grid-template-columns: 300px 1fr; gap: 32px; padding: 30px 0; border-top: 1px solid var(--line); }
    .pg:first-of-type { margin-top: 26px; }
    .pg-h h2 { margin-top: 0; }
    .pcards { grid-template-columns: repeat(2, 1fr); margin-top: 0; }
  }
  .pnote { margin-top: 30px; font-size: 12.5px; color: var(--sub); }
</style>

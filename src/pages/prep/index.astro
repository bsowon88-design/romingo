---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import Icon from '../../components/Icon.astro';
const ICO = { data: 'wifi', flight: 'plane', tour: 'ticket', stay: 'bed-double', car: 'car' };
import { PARTNERS, CATS, AD_NOTE, PREP_GUIDES } from '../../data/partners.js';
import CoupangChips from '../../components/CoupangChips.astro';
import { CP_COMMON } from '../../data/coupang.js';
// 종류 순서대로 한 판에 (PC 4개씩 · 폰 2개씩)
const catOf = Object.fromEntries(CATS.map((c) => [c.id, c]));
const list = CATS.flatMap((c) => PARTNERS.filter((p) => p.cat === c.id));
const firstOf = new Set(CATS.map((c) => PARTNERS.find((p) => p.cat === c.id)?.id));
---
<Base title="해외여행 준비 - eSIM·항공권·투어·숙소·렌터카 업체 비교" desc="해외여행 전에 준비할 데이터(eSIM), 항공권, 투어·입장권, 숙소, 렌터카를 업체별 장점으로 한눈에 비교합니다.">
  <PageBanner name="prep">
    <p class="crumb"><a href="/">홈</a> › 여행 준비</p>
    <h1>여행 준비</h1>
    <p class="lead">데이터 · 항공권 · 투어 · 숙소 · 렌터카, 업체별 강점 비교</p>
  </PageBanner>
  <p class="adn"><em>광고</em> {AD_NOTE}</p>

  <div class="pcards">
    {list.map((p) => {
      const c = catOf[p.cat];
      return (
        <article class="pc" id={firstOf.has(p.id) ? p.cat : undefined}>
          <div class={`hd h-${p.cat}`}>
            <span class="tag">{c.name.replace(/ \(.*\)$/, '')}{p.only && ' · 일본만'}</span>
            <h3>{p.name}</h3>
            <span class="big"><Icon name={ICO[p.cat]} size={76} stroke={1.5} /></span>
          </div>
          <p class="pbest">👍 {p.best}</p>
          <ul>{p.pros.slice(0, 2).map((x) => <li>{x}</li>)}</ul>
          {p.note && <p class="pnote">{p.note}</p>}
          {p.url
            ? <a class="pgo" href={p.url} target="_blank" rel="sponsored nofollow noopener">보러 가기 ↗</a>
            : <span class="pgo off">링크 준비 중</span>}
        </article>
      );
    })}
  </div>

  <section id="items"><CoupangChips keys={CP_COMMON} title="여행 준비물" /></section>

  {PREP_GUIDES.length > 0 && (
    <section class="pgl">
      <h2>📖 준비 가이드</h2>
      <div class="pgl-g">
        {PREP_GUIDES.map((g) => <a href={`/prep/${g.slug}/`}><b>{g.title}</b><span>{g.desc}</span></a>)}
      </div>
    </section>
  )}

  <details class="tips">
    <summary>고르기 전에 알아 두면 좋은 것</summary>
    <ul>{CATS.map((c) => <li><b>{c.ico} {c.name}</b> — {c.lead}</li>)}</ul>
  </details>

  <p class="pnote">장점은 각 업체의 공식 앱 소개와 공식 사이트 안내를 바탕으로 작성했습니다 (2026년 11월 확인). 가격·조건은 바뀔 수 있으니 결제 전에 업체 화면에서 꼭 확인하세요.</p>
</Base>

<style>
  .adn { font-size: 13px; color: var(--sub); background: #FFF6EF; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; margin: 0 0 14px; }
  .adn em { font-style: normal; font-weight: 800; color: var(--sea); margin-right: 4px; }
  .pcards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .pc { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; padding: 0 14px 12px; background: #fff; scroll-margin-top: 80px; overflow: hidden; }
  .hd { position: relative; overflow: hidden; margin: 0 -14px 10px; padding: 12px 14px 12px; min-height: 92px; display: flex; flex-direction: column; justify-content: space-between; color: #fff; }
  .hd .tag { position: relative; z-index: 1; align-self: flex-start; font-size: 11.5px; font-weight: 800; border-radius: 7px; padding: 3px 8px; background: rgba(255,255,255,.25); color: #fff; backdrop-filter: blur(2px); }
  .hd h3 { position: relative; z-index: 1; margin: 10px 0 0 !important; font-size: 20px !important; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.18); }
  .hd .big { position: absolute; right: -6px; bottom: -14px; color: rgba(255,255,255,.28); transform: rotate(-8deg); }
  .h-data { background: linear-gradient(135deg, #5B8DEF, #2F5FA8); }
  .h-flight { background: linear-gradient(135deg, #4CB782, #2D7A55); }
  .h-tour { background: linear-gradient(135deg, #F49A5C, #D0602A); }
  .h-stay { background: linear-gradient(135deg, #A57BD6, #6A3E91); }
  .h-car { background: linear-gradient(135deg, #F2C14E, #C38A12); }
  .pc:target { border-color: var(--coral); box-shadow: 0 0 0 3px #FFE3D2; }
  .tag { align-self: flex-start; font-size: 11.5px; font-weight: 800; border-radius: 7px; padding: 3px 8px; background: #F4F1EF; color: #6B5B52; }
  .t-data { background: #EEF4FF; color: #2F5FA8; }
  .t-flight { background: #EAF6EE; color: #2D6B45; }
  .t-tour { background: #FFF1E6; color: #A8521E; }
  .t-stay { background: #F5EEFB; color: #6A3E91; }
  .t-car { background: #FFF6D9; color: #8A6A0E; }
  .pc h3 { margin: 7px 0 0; font-size: 18px; }
  .pbest { margin: 4px 0 6px; font-size: 13px; font-weight: 700; color: var(--sea); }
  .pnote { margin: -4px 0 10px; font-size: 11px; line-height: 1.5; color: var(--sub); }
  .pc ul { margin: 0 0 10px; padding-left: 16px; font-size: 13px; line-height: 1.6; color: #4a3b33; }
  .pgo { margin-top: auto; display: block; text-align: center; text-decoration: none; font-size: 14px; font-weight: 800; color: #fff; background: var(--sea); border-radius: 10px; padding: 8px; }
  .pgo:hover { filter: brightness(1.06); }
  .pgo.off { background: #F3ECE7; color: var(--sub); font-weight: 600; }
  .pgl h2 { margin: 28px 0 10px; }
  .pgl-g { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .pgl-g a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); border: 1px solid var(--line); border-radius: 14px; padding: 13px 15px; background: #fff; }
  .pgl-g a:hover { border-color: var(--coral); }
  .pgl-g b { font-size: 16px; }
  .pgl-g span { font-size: 13px; color: var(--sub); }
  @media (max-width: 760px) { .pgl-g { grid-template-columns: 1fr; } }
  .tips { margin-top: 16px; border: 1px solid var(--line); border-radius: 12px; padding: 0 14px; background: #fff; }
  .tips summary { cursor: pointer; padding: 11px 0; font-weight: 700; font-size: 14px; }
  .tips ul { margin: 0 0 12px; padding-left: 18px; font-size: 13.5px; line-height: 1.7; color: #4a3b33; }
  .pnote { margin-top: 18px; font-size: 12.5px; color: var(--sub); }
  @media (max-width: 1000px) { .pcards { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) {
    .pcards { grid-template-columns: 1fr 1fr; gap: 8px; }
    .pc { padding: 10px 10px 10px; }
    .pc h3 { font-size: 15.5px; }
    .pbest { font-size: 12px; }
    .pc ul { font-size: 12px; padding-left: 14px; }
    .tag { font-size: 10.5px; padding: 2px 6px; }
  }
</style>

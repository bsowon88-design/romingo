---
import Base from '../layouts/Base.astro';
import QuakeRow from '../components/QuakeRow.astro';
import { bigQuakes } from '../data/load.js';

const list = bigQuakes.slice(0, 300);
const groups = [];
for (const q of list) {
  const key = new Intl.DateTimeFormat('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long' }).format(new Date(q.time));
  let g = groups.find((x) => x.key === key);
  if (!g) groups.push((g = { key, items: [] }));
  g.items.push(q);
}
---
<Base title="전세계 큰 지진 기록" desc="전세계에서 일어난 규모 5 이상 지진을 한국 시간·한국어 위치로 정리했어요. 미국 지질조사국(USGS) 공식 자료 기준.">
  <p class="crumb"><a href="/">홈</a> › 지진</p>
  <h1>전세계 큰 지진 기록</h1>
  <p class="lead">규모 5 이상 지진을 한국 시간으로 정리했어요. 누르면 위치 지도와 여행자 안내를 볼 수 있어요.</p>
  {groups.length ? groups.map((g) => (
    <>
      <h2>{g.key} <small>{g.items.length}번</small></h2>
      <ul class="qlist">{g.items.map((q) => <QuakeRow q={q} />)}</ul>
    </>
  )) : <p class="card empty">아직 기록이 없어요. 곧 자동으로 채워져요.</p>}
</Base>

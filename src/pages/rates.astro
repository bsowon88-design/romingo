---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Flag from '../components/Flag.astro';
import { rateList } from '../data/load.js';
import { flagOf } from '../data/countries.js';

const date = rateList[0]?.line?.date || '';
import rates from '../data/archive/rates.json';
const data = rateList.map((r) => ({ cur: r.cur, name: r.name, ko: r.c.ko, value: r.value, unit: r.unit, hist: rates?.[r.cur]?.hist || null }));
const mv = (cur) => { const h = rates?.[cur]?.hist; const v = rates?.[cur]?.value; return Array.isArray(h) && h.length >= 8 && h[0] ? ((v - h[0]) / h[0]) * 100 : null; };
---
<Base title="오늘 환율 - 엔·달러·동·바트 등 여행 환율 계산기" desc="일본 엔, 미국 달러, 베트남 동, 태국 바트 등 여행 가는 나라의 오늘 환율(한국은행 매매기준율)과 원화 환전 계산기.">
  <PageBanner name="rates">
    <p class="crumb"><a href="/">홈</a> › 환율</p>
    <h1>오늘 여행 환율</h1>
    <p class="lead">한국은행 매매기준율{date && ` · ${date} 기준`}. 실제 환전·카드 환율과는 차이가 있습니다.</p>
  </PageBanner>

  {data.length ? (
    <>
      <section class="card calc">
        <h2>🧮 환율 계산기</h2>
        <div class="crow">
          <label>원화<input id="won" type="number" inputmode="numeric" value="100000" min="0" step="1000" /></label>
          <span class="arrow">→</span>
          <label>나라
            <select id="cur">
              {data.map((r) => <option value={r.cur}>{r.ko} ({r.name})</option>)}
            </select>
          </label>
        </div>
        <p class="res" id="res">&nbsp;</p>
        <div class="crow">
          <label>현지 돈<input id="fx" type="number" inputmode="decimal" value="" min="0" /></label>
          <span class="arrow">→</span>
          <p class="res2" id="res2">원화로 얼마인지 보여 줘요</p>
        </div>
      </section>

      <section class="card cheat" id="cheat">
        <div class="ch-h">
          <h2>📋 현지에서 보는 금액표 <small id="ch-name"></small></h2>
          <button type="button" class="btn ghost" id="ch-save">🖼️ 이미지로 저장</button>
        </div>
        <p class="muted ch-n">현지에서 값을 볼 때 원화로 얼마쯤인지 바로 보세요. 위 계산기에서 나라를 바꾸면 같이 바뀌어요. 인터넷이 없을 때를 위해 이미지로 저장해 두세요.</p>
        <div class="ch-g" id="ch-g"></div>
        <p class="ch-trend" id="ch-trend"></p>
      </section>

      <h2>💱 나라별 환율</h2>
      <div class="rtab card">
        {rateList.map((r) => (
          <a class="rr" href={`/country/${r.c.slug}/info/`}>
            <span class="nm"><Flag iso={flagOf(r.c)} size={24} /> {r.c.ko} <small>{r.name}</small></span>
            <b>{r.line.line1}</b>
            <span class="muted">{r.line.line2}{mv(r.cur) != null && Math.abs(mv(r.cur)) >= 0.1 && <em class={mv(r.cur) > 0 ? 'up' : 'dn'}> · 한 달 {mv(r.cur) > 0 ? '▲' : '▼'}{Math.abs(mv(r.cur)).toFixed(1)}%</em>}</span>
          </a>
        ))}
      </div>
    </>
  ) : (
    <p class="card empty">환율 자료를 모으는 중이에요.</p>
  )}

  <script type="application/json" id="rates-data" set:html={JSON.stringify(data)}></script>
  <span id="rates-date" hidden>{date}</span>
</Base>

<script>
  const data = JSON.parse(document.getElementById('rates-data')?.textContent || '[]');
  const by = Object.fromEntries(data.map((r) => [r.cur, r]));
  const won = document.getElementById('won') as HTMLInputElement | null;
  const cur = document.getElementById('cur') as HTMLSelectElement | null;
  const fx = document.getElementById('fx') as HTMLInputElement | null;
  const res = document.getElementById('res');
  const res2 = document.getElementById('res2');
  const fmt = (n: number) => (n >= 100 ? Math.round(n).toLocaleString('ko-KR') : n.toLocaleString('ko-KR', { maximumFractionDigits: 2 }));
  function calc() {
    const r = by[cur?.value || ''];
    if (!r || !res || !res2) return;
    const w = +(won?.value || 0);
    res.textContent = `${fmt(w)}원 ≈ ${fmt((w / r.value) * r.unit)} ${r.name}`;
    const f = +(fx?.value || 0);
    res2.textContent = f ? `${fmt(f)} ${r.name} ≈ ${fmt((f / r.unit) * r.value)}원` : `${r.name} 금액을 넣으면 원화로 바꿔 줘요`;
  }
  [won, cur, fx].forEach((el) => el?.addEventListener('input', calc));
  calc();

  // 현지 금액표 — 원화 1천 원쯤부터 시작하는 보기 좋은 금액들
  const chG = document.getElementById('ch-g');
  const chName = document.getElementById('ch-name');
  const chTrend = document.getElementById('ch-trend');
  let rowsNow: [string, string][] = [];
  function cheat() {
    const r = by[cur?.value || ''];
    if (!r || !chG) return;
    const per = r.value / r.unit; // 현지 1단위 = 원
    let base = 1;
    while (base * per < 800) base *= 10;
    const steps = [1, 2, 5, 10, 20, 50, 100, 200].map((k) => k * base);
    rowsNow = steps.map((a) => [`${a.toLocaleString('ko-KR')} ${r.name}`, `${fmt(a * per)}원`]);
    chG.replaceChildren(...rowsNow.map(([a, b]) => { const d = document.createElement('div'); d.className = 'ch-r'; const x = document.createElement('span'); x.textContent = a; const y = document.createElement('b'); y.textContent = b; d.append(x, y); return d; }));
    if (chName) chName.textContent = `${r.ko} · ${r.name}`;
    if (chTrend) {
      const h = r.hist;
      if (Array.isArray(h) && h.length >= 8 && h[0]) {
        const p = ((r.value - h[0]) / h[0]) * 100;
        chTrend.textContent = Math.abs(p) < 0.1 ? '최근 한 달 동안 거의 그대로예요.' : `최근 한 달 사이 ${r.name} 값이 ${Math.abs(p).toFixed(1)}% ${p > 0 ? '올랐어요 (원화로 더 비싸졌어요)' : '내렸어요 (원화로 더 싸졌어요)'}.`;
      } else chTrend.textContent = '';
    }
  }
  cur?.addEventListener('input', cheat);
  cheat();

  // 이미지로 저장 — 금액표를 그림 한 장으로
  document.getElementById('ch-save')?.addEventListener('click', () => {
    const r = by[cur?.value || ''];
    if (!r) return;
    const W = 720, rowH = 64, top = 178, H = top + Math.ceil(rowsNow.length / 2) * rowH + 40;
    const cv = document.createElement('canvas');
    cv.width = W * 2; cv.height = H * 2;
    const g = cv.getContext('2d')!;
    g.scale(2, 2);
    g.fillStyle = '#FFF6EF'; g.fillRect(0, 0, W, H);
    g.fillStyle = '#2E2420'; g.font = '800 34px Pretendard, sans-serif';
    g.fillText(`${r.ko} 금액표`, 36, 64);
    g.fillStyle = '#7A665B'; g.font = '500 18px Pretendard, sans-serif';
    g.fillText(`${r.name} → 원화 · 한국은행 매매기준율 ${document.getElementById('rates-date')?.textContent || ''}`, 36, 100);
    rowsNow.forEach(([a, b], i) => {
      const x = 36 + (i % 2) * 330, y = top + Math.floor(i / 2) * rowH;
      g.fillStyle = '#FFFFFF'; g.beginPath(); (g as any).roundRect ? (g as any).roundRect(x, y - 40, 314, 54, 12) : g.rect(x, y - 40, 314, 54); g.fill();
      g.fillStyle = '#7A665B'; g.font = '600 18px Pretendard, sans-serif'; g.fillText(a, x + 16, y - 6);
      g.fillStyle = '#C85E30'; g.font = '800 22px Pretendard, sans-serif'; const tw = g.measureText(b).width; g.fillText(b, x + 298 - tw, y - 6);
    });
    g.fillStyle = '#B39C8F'; g.font = '500 15px Pretendard, sans-serif';
    g.fillText('트립베리 · tripberry.kr · 실제 환전·카드 환율과는 조금 달라요', 36, H - 28);
    const link = document.createElement('a');
    link.download = `트립베리-${r.ko}-금액표.png`;
    link.href = cv.toDataURL('image/png');
    link.click();
  });
</script>

<style>
  .calc { margin-top: 16px; }
  .calc h2 { margin-top: 0; }
  .crow { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .crow label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; color: var(--sub); }
  .crow input, .crow select { font: inherit; font-size: 17px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; min-width: 180px; color: var(--ink); background: #fff; }
  .arrow { font-size: 20px; padding-bottom: 10px; color: var(--sub); }
  .res { font-size: 22px; font-weight: 800; color: var(--sea); margin: 12px 0 4px; }
  .res2 { font-size: 17px; font-weight: 700; color: var(--green); margin: 0 0 10px; }
  .cheat { margin-top: 16px; }
  .ch-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .ch-h h2 { margin: 0; }
  .ch-h h2 small { font-size: 14px; color: var(--sub); font-weight: 600; }
  .ch-n { font-size: 13px; margin: 6px 0 10px; }
  .ch-g { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .ch-g :global(.ch-r) { display: flex; flex-direction: column; gap: 2px; background: #FFF8F3; border: 1px solid #F6E3D6; border-radius: 12px; padding: 10px 12px; }
  .ch-g :global(.ch-r span) { font-size: 13px; color: var(--sub); font-weight: 600; }
  .ch-g :global(.ch-r b) { font-size: 18px; color: var(--sea); font-variant-numeric: tabular-nums; }
  .ch-trend { font-size: 13.5px; font-weight: 600; margin: 10px 0 0; }
  .rr em { font-style: normal; font-weight: 700; }
  .rr em.up { color: #d6383a; } .rr em.dn { color: #2f78c4; }
  @media (max-width: 760px) { .ch-g { grid-template-columns: 1fr 1fr; } }
  .rtab { padding: 4px 0; }
  .rr { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 10px; align-items: center; padding: 12px 16px; text-decoration: none; }
  .rr + .rr { border-top: 1px solid var(--line); }
  .rr:hover { background: #FFF8F3; }
  .nm { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; }
  .nm small { color: var(--sub); font-weight: 500; }
  @media (max-width: 620px) {
    .rr { grid-template-columns: 1fr 1fr; }
    .rr .muted { display: none; }
    .crow input, .crow select { min-width: 0; width: 100%; }
    .crow label { flex: 1; }
    .res2 { width: 100%; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Flag from '../../components/Flag.astro';
import YtCards from '../../components/YtCards.astro';
import { CITIES } from '../../data/cities.js';
import { bySlug, flagOf, REGIONS, COUNTRIES } from '../../data/countries.js';
import { ytOf } from '../../data/youtube.js';

const rOrder = REGIONS.map((r) => r[0]);
const cOrder = COUNTRIES.map((c) => c.slug);
const cities = CITIES.map((x, i) => ({ x, co: bySlug[x.country], list: ytOf(x.slug), i }))
  .filter((o) => o.co && o.list.length)
  .sort((a, b) => rOrder.indexOf(a.co.region) - rOrder.indexOf(b.co.region) || cOrder.indexOf(a.co.slug) - cOrder.indexOf(b.co.slug) || a.i - b.i);
const regs = REGIONS.map(([k, l]) => [k, l, cities.filter((o) => o.co.region === k).length]).filter((r) => r[2] > 0);
// 이번 주 많이 본 영상 — 도시마다 1위 영상 중 조회수 높은 순
const seen = new Set();
const top = cities.map((o) => o.list[0]).filter((v) => v && !seen.has(v.id) && seen.add(v.id)).sort((a, b) => b.views - a.views).slice(0, 8);
---
<Base title="여행 영상 - 한국 여행 유튜버가 다녀온 해외 도시 영상 모음" desc="도쿄, 오사카, 다낭, 방콕, 파리 등 해외 도시별로 한국 여행 유튜버의 최신 여행 영상을 모았습니다. 가기 전에 영상으로 미리 둘러보세요.">
  <section class="vhero">
    <p class="crumb"><a href="/">홈</a> › 여행 영상</p>
    <h1>여행 영상</h1>
    <p class="lead">한국 여행 유튜버의 도시별 여행 영상. 가기 전에 분위기를 미리 보고, 일정은 가이드에서 챙기세요.</p>
  </section>

  {cities.length === 0 ? (
    <p class="empty">영상 수집 중 · 하루 안에 도시별 영상이 표시됩니다.</p>
  ) : (
    <>
      <h2>요즘 많이 본 여행 영상</h2>
      <YtCards list={top} />

      <h2>도시별 여행 영상</h2>
      <div class="gfil" id="vfil">
        <button type="button" class="on" data-r="">전체 <small>{cities.length}</small></button>
        {regs.map(([k, l, n]) => <button type="button" data-r={k}>{l} <small>{n}</small></button>)}
      </div>
      <div class="vcity" id="vcity">
        {cities.map(({ x, co, list }) => (
          <a class="vc" data-r={co.region} href={`/videos/${x.slug}/`}>
            <span class="vc-img"><img src={`https://i.ytimg.com/vi/${list[0].id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" /><span class="vc-n">▶ {list.length}</span></span>
            <span class="vc-t"><Flag iso={flagOf(co)} size={16} /> <b>{x.ko}</b><small>{co.ko}</small></span>
          </a>
        ))}
      </div>
    </>
  )}
  <p class="muted note">유튜브에서 도시 이름으로 찾은 한국어 여행 영상 중 조회수가 높은 영상을 일주일마다 업데이트됩니다. 영상의 저작권은 만든 유튜버에게 있고, 재생은 유튜브가 허락한 방식을 따라요.</p>
</Base>

<script>
  const fil = document.getElementById('vfil');
  if (fil) {
    const cards = document.querySelectorAll<HTMLElement>('#vcity .vc');
    const apply = (r: string) => {
      fil.querySelectorAll<HTMLElement>('button').forEach((b) => b.classList.toggle('on', b.dataset.r === r));
      cards.forEach((c) => { c.style.display = !r || c.dataset.r === r ? '' : 'none'; });
    };
    fil.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      apply(b.dataset.r || '');
    });
  }
</script>

<style>
  .vhero { border-radius: 22px; padding: 34px 32px; min-height: 210px; display: flex; flex-direction: column; justify-content: center; margin: 6px 0 10px; background: #0f2233; color: #fff; }
  .vhero .crumb, .vhero .crumb a { color: rgba(255,255,255,.8); }
  .vhero h1 { margin: 4px 0 8px; font-size: 32px; color: #fff; }
  .vhero .lead { margin: 0; color: rgba(255,255,255,.9); max-width: 560px; text-shadow: 0 1px 6px rgba(0,0,0,.35); }
  .empty { padding: 24px; border: 1px dashed var(--line); border-radius: 14px; background: #fff; font-weight: 600; }
  h2 { margin-top: 30px; }
  .gfil { display: flex; gap: 8px; flex-wrap: wrap; margin: 4px 0 14px; }
  .gfil button { border: 1px solid var(--line); background: #fff; color: var(--ink); font-weight: 700; font-size: 14.5px; padding: 8px 14px; border-radius: 999px; cursor: pointer; }
  .gfil button small { color: var(--sub); font-weight: 600; margin-left: 2px; }
  .gfil button.on { background: var(--ink); border-color: var(--ink); color: #fff; }
  .gfil button.on small { color: rgba(255,255,255,.75); }
  .vcity { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .vc { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); }
  .vc-img { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #0f2233; }
  .vc-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
  .vc:hover .vc-img img { transform: scale(1.05); }
  .vc-n { position: absolute; right: 6px; bottom: 6px; background: rgba(0,0,0,.75); color: #fff; font-size: 12px; font-weight: 700; padding: 2px 7px; border-radius: 6px; }
  .vc-t { display: flex; align-items: center; gap: 6px; font-size: 15.5px; }
  .vc-t small { color: var(--sub); font-size: 12.5px; }
  .note { margin-top: 26px; font-size: 13px; }
  @media (max-width: 640px) {
    .vhero { padding: 22px 18px; min-height: 190px; justify-content: flex-end; background: #0f2233; } .vhero h1 { font-size: 25px; }
    .gfil { flex-wrap: nowrap; overflow-x: auto; margin: 4px -18px 14px; padding: 0 18px; scrollbar-width: none; } .gfil button { flex: none; }
    .vcity { grid-template-columns: 1fr 1fr; gap: 10px; }
  }
</style>
